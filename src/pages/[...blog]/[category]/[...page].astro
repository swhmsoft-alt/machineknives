---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';

import { buildBlogPostBreadcrumb } from '~/utils/breadcrumb';
import { getTopic, topicsIndexHref } from '~/data/topics';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

// Look up the topic definition (if any) for this category slug. Unknown
// slugs (e.g. legacy posts filed under ad-hoc categories) fall back to
// article-style rendering.
const topic = getTopic(category.slug);

// The category pages live at `/category/{slug}/`, not under `/blog/`, so
// supply a breadcrumb explicitly to surface the Blog parent. The category
// page is shown as the current page (no `href` on the tail item).
const breadcrumbItems = buildBlogPostBreadcrumb(category.title);

// Mirror the visible breadcrumb as JSON-LD so crawlers see the Blog parent.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((it, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: it.text,
    item: it.href ? String(new URL(it.href, Astro.site ?? 'https://www.machine-knives.net')) : Astro.url.toString(),
  })),
};

// Build a content-type-aware page description so AI crawlers can tell at a
// glance what kind of content lives at this URL (long-form article vs.
// glossary entry vs. comparison table).
const pageDescription =
  topic?.contentType === 'glossary'
    ? `Reference entries in the ${topic.title} topic — concise, AI-citable definitions curated by KAIPU engineering.`
    : topic?.contentType === 'comparison'
      ? `${topic.title} — a side-by-side reference table for industrial blade specification. Curated and maintained by KAIPU engineering.`
      : `Articles in the ${category.title} topic — engineering content for industrial blade selection, application and performance.`;

const metadata = {
  title: `${category.title}${currentPage > 1 ? ` — Page ${currentPage}` : ''} | KAIPU Blog`,
  description: pageDescription,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata} breadcrumb={breadcrumbItems}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline>
      {category.title}
    </Headline>

    {/*
      Topic-aware intro strip. Surfaces the topic's icon, content-type
      label, and (for comparison topics) a clear "single-page table" note
      so users know what to expect before scrolling. Not rendered for
      legacy/unknown categories.
    */}
    {topic && (
      <div class="mb-8 md:mb-10 flex flex-wrap items-center justify-center gap-3 text-sm text-muted dark:text-slate-400">
        <span class="inline-flex items-center gap-2">
          <Icon name={topic.icon} class="w-5 h-5 text-primary" />
          <span class="font-semibold uppercase tracking-wide text-secondary dark:text-blue-200">
            {topic.contentType}
          </span>
        </span>
        <span aria-hidden="true">·</span>
        <span>Target: {topic.countLabel} {topic.targetCount === 1 ? 'entry' : 'posts'}</span>
        <span aria-hidden="true">·</span>
        <a class="inline-flex items-center text-primary hover:underline" href={topicsIndexHref()}>
          All topics
          <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1" />
        </a>
      </div>
    )}

    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
