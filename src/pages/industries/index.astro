---
// industries-served hub —Trinity audit reference
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Industries Served —Printing, Packaging, Paper, Food, Recycling, Converting, Metal',
  description:
    'KAIPU Industrial Blades has supplied precision machine knives to six core industries since 1998. ISO 9001:2015 certified, materials per ASTM A681 / DIN 1.2379 / JIS SKD11, in-house heat treatment and PVD coating. 5— weeks lead time on standard blade geometries.',
};

const heroImageHtml =
  '<img src="/images/industries/index/six-sectors-overview.jpg" alt="Industries served by KAIPU —six sectors (placeholder)" class="mx-auto rounded-md w-full" width="1024" height="576" loading="eager" />';

const SITE_URL = 'https://www.machine-knives.net';
const PAGE_URL = `${SITE_URL}/industries/`;

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Industries served by KAIPU Industrial Blades',
  url: PAGE_URL,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Printing & Packaging', url: `${PAGE_URL}printing-packaging/` },
    { '@type': 'ListItem', position: 2, name: 'Paper & Tissue', url: `${PAGE_URL}paper-tissue/` },
    { '@type': 'ListItem', position: 3, name: 'Food Processing', url: `${PAGE_URL}food-processing/` },
    { '@type': 'ListItem', position: 4, name: 'Plastics Recycling', url: `${PAGE_URL}plastics-recycling/` },
    { '@type': 'ListItem', position: 5, name: 'Converting', url: `${PAGE_URL}converting/` },
    { '@type': 'ListItem', position: 6, name: 'Metalworking', url: `${PAGE_URL}metalworking/` },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Industrial Blade Manufacturing and Regrind Service',
  serviceType: 'Custom industrial blade manufacturing',
  provider: {
    '@type': 'Organization',
    name: 'KAIPU Industrial Blades',
    foundingDate: '1998',
    url: SITE_URL,
  },
  areaServed: ['Printing', 'Packaging', 'Paper', 'Tissue', 'Food processing', 'Plastics recycling', 'Converting', 'Metalworking'],
  description:
    'Custom and catalog industrial blades supplied to converters, recyclers and OEMs across four continents. Engineering review, DFM feedback, Mill Test Certificate per EN 10204 3.1, and in-house regrind service.',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'USD',
    priceRange: '$$',
  },
};

const stats = [
  { amount: '27+', title: 'Years in Business', icon: 'tabler:calendar' },
  { amount: '6', title: 'Core Industries Served', icon: 'tabler:building-factory' },
  { amount: '50+', title: 'Steel Grades in Stock', icon: 'tabler:layers-intersect' },
  { amount: '5— wk', title: 'Standard Lead Time', icon: 'tabler:clock' },
  { amount: '98%', title: 'On-Time Delivery', icon: 'tabler:truck-delivery' },
  { amount: '4', title: 'Continents Shipped To', icon: 'tabler:world' },
];

const industries = [
  {
    title: 'Printing & Packaging',
    href: '/industries/printing-packaging/',
    description:
      '<strong>Best for:</strong> slitting, sheeting and rewinding of paper, film, foil and laminate. Tight burr control protects printed surfaces and clean edges. <strong>Not for:</strong> ferrous metal coil slitting above 0.5 mm (use a Metalworking blade). Materials specified per ASTM A681 (D2) and JIS SKD11.',
    icon: 'tabler:printer',
  },
  {
    title: 'Paper & Tissue',
    href: '/industries/paper-tissue/',
    description:
      '<strong>Best for:</strong> long-life bed knives and top blades for tissue converting lines. <strong>Ideal for:</strong> 600—,400 m/min tissue lines. Optimised cutting angles reduce dust and extend service intervals. <strong>Not suitable for</strong> hand-towel folding lines that require a creasing shoe retrofit.',
    icon: 'tabler:toilet-paper',
  },
  {
    title: 'Food Processing',
    href: '/industries/food-processing/',
    description:
      '<strong>Best for:</strong> slicing, dicing and portioning of bread, cheese, meat and vegetable lines. Stainless and tool-steel blades for washdown environments and food-contact compliance. <strong>Not for:</strong> cryogenic or frozen-block cutting (consult engineering first). Material traceability documented per ISO 9001:2015 §8.5.',
    icon: 'tabler:leaf',
  },
  {
    title: 'Plastics Recycling',
    href: '/industries/plastics-recycling/',
    description:
      '<strong>Best for:</strong> granulator and shredder rotor / stator knives cutting through contamination, glass fibre and reinforced polymers. D2 and M2 HSS options, with optional TiN or CrN coating to extend interval by 2—×. <strong>Not for:</strong> highly abrasive mineral-filled compounds above 40 % glass.',
    icon: 'tabler:recycle',
  },
  {
    title: 'Converting',
    href: '/industries/converting/',
    description:
      '<strong>Best for:</strong> trim and score blades for pouch-making, label stock and adhesive tape lines. Repeatable edge profile across production shifts, with run-out controlled to ≤ 0.01 mm on Ø 250 mm blanks. <strong>Not suitable for</strong> very thick rigid sheet above 2 mm.',
    icon: 'tabler:layout',
  },
  {
    title: 'Metalworking',
    href: '/industries/metalworking/',
    description:
      '<strong>Best for:</strong> guillotine and swing-beam shears cutting mild steel, stainless and aluminium plate up to 12 mm. HRC 58—2 working hardness, ground and polished to ≤Ra 0.4 µm. <strong>Not for:</strong> hot-slab cutting (use a hot-shear grade with HRC 46—0).',
    icon: 'tabler:tool',
  },
];

const comparisonRows = [
  { industry: 'Printing & Packaging', substrate: 'Paper, film, foil, laminate', grade: 'D2 / SKD11', hardness: 'HRC 58—2', throughput: 'Up to 1,200 m/min', edge: '6—0 weeks' },
  { industry: 'Paper & Tissue', substrate: 'Tissue, towel, napkin', grade: 'D2 / 1.2379', hardness: 'HRC 60—2', throughput: '600—,400 m/min', edge: '4— weeks' },
  { industry: 'Food Processing', substrate: 'Bread, cheese, meat, vegetable', grade: '440C / 1.4112', hardness: 'HRC 56—8', throughput: 'Up to 600 cuts/min', edge: '2— weeks' },
  { industry: 'Plastics Recycling', substrate: 'PE, PP, PET, glass-filled', grade: 'D2 + TiN / CrN', hardness: 'HRC 58—0', throughput: 'Up to 800 kg/h', edge: '2— weeks' },
  { industry: 'Converting', substrate: 'Pouch, label, adhesive tape', grade: 'M2 / SKH51', hardness: 'HRC 62—4', throughput: 'Up to 250 m/min', edge: '4— weeks' },
  { industry: 'Metalworking', substrate: 'Mild / stainless / aluminium plate', grade: 'D2 / 1.2379', hardness: 'HRC 58—2', throughput: 'Up to 22 strokes/min', edge: '8—2 weeks' },
];

const processSteps = [
  {
    title: 'Step 1: Submit a drawing or worn sample',
    description:
      'Send your STEP, IGES, DWG or DXF file plus the operating envelope (substrate, throughput, web tension, hygiene grade). Our engineering team responds within one business day.',
    icon: 'tabler:clipboard-text',
  },
  {
    title: 'Step 2: DFM review and Cpk sign-off',
    description:
      'We run a Design-for-Manufacturing review, propose a steel grade and edge geometry, and validate manufacturability with a Cpk ≥ 1.33 capability study on critical dimensions before tooling.',
    icon: 'tabler:compass',
  },
  {
    title: 'Step 3: Sample blade and field trial',
    description:
      'A prototype is shipped for a 2— week field trial on your line. Yield, defect rate and edge life are logged against the agreed specification. We iterate up to two times before release.',
    icon: 'tabler:flask',
  },
  {
    title: 'Step 4: Production with 5— weeks lead time',
    description:
      'Production orders are scheduled on a dedicated 5-axis grinding cell with a 5,000-blade monthly capacity and a backup machine on the same floor to protect your delivery date.',
    icon: 'tabler:settings',
  },
  {
    title: 'Step 5: MTC per EN 10204 3.1 and CMM inspection',
    description:
      'Every shipment ships with a Mill Test Certificate per EN 10204 3.1, a HEXAGON Global S CMM dimensional report, and an AS9102-style FAIR package on request.',
    icon: 'tabler:certificate',
  },
  {
    title: 'Step 6: Logistics, regrind and after-sales support',
    description:
      'Standard Incoterms are FOB Ningbo, CIF or DDP. Worn blades can be returned for in-house regrind service —same steel, same geometry, lower cost per cutting hour.',
    icon: 'tabler:truck-delivery',
  },
];

const faqs = [
  {
    title: 'Which industry blade should I start with if my line is not listed?',
    description:
      'Pick the industry whose substrate and throughput are closest to your process, then send us a drawing. Our engineering team will re-classify the application and recommend the steel grade, edge geometry and tolerance window. Most cross-industry quotes are turned around within one business day.',
  },
  {
    title: 'What is the minimum order quantity (MOQ)?',
    description:
      'MOQ is one blade for engineering samples. Production orders typically start at 20 units. For complex 4-edge indexable designs, the first production run is 50 units to amortise setup cost.',
  },
  {
    title: 'How long does a custom blade take from drawing to dispatch?',
    description:
      'Standard geometries ship in 5— weeks. Custom builds against a new drawing typically ship in 8—2 weeks, including the DFM review and the field trial.',
  },
  {
    title: 'Do you regrind blades supplied by other manufacturers?',
    description:
      'Yes. Send us a worn sample and we will measure the current edge geometry, regrind to OEM or KAIPU specification, and return a regrind report with edge-life expectations. We regrind blades from most major OEMs including Bosch, S&S, BSH and Herbert.',
  },
  {
    title: 'Which file formats can I send with my RFQ?',
    description:
      'We accept STEP, IGES, DWG, DXF, SolidWorks and CATIA files. A 2D drawing with critical dimensions, hardness, surface finish and tolerance call-outs is sufficient for most catalog items.',
  },
  {
    title: 'How is the steel grade selected for a food-contact application?',
    description:
      'For food-contact lines we default to 440C (DIN 1.4112) stainless with documented material traceability per ISO 9001:2015 §8.5, electropolished cutting edges, and a Mill Test Certificate per EN 10204 3.1 included in every shipment.',
  },
];

const framework = {
  title: 'The 5-Factor Cut Validation Method',
  body:
    'Every KAIPU blade is qualified against a proprietary 5-Factor framework before it leaves the floor: (1) substrate classification against ASTM A681 / DIN 1.2379 grade tables, (2) edge geometry on a 0.0019 mm HEXAGON Global S CMM, (3) hardness survey per Rockwell C with three-point mapping, (4) Cpk ≥ 1.33 capability study on the critical cut dimension, and (5) a documented 2— week field trial on the customer line. Lines that pass all five factors ship with a 98 % on-time delivery commitment and a 12-month edge-life guarantee.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": "The 5-Factor Blade Selection Framework",
        "url": "https://www.machine-knives.net/kaipu-5-factor-blade-selection-framework/",
        "datePublished": "2026-01-15",
        "author": { "@type": "Organization", "name": "KAIPU Industrial Blades" }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": "How to specify an industrial blade for KAIPU",
        "totalTime": "P12W",
        "estimatedCost": { "@type": "MonetaryAmount", "currency": "USD", "value": "0" },
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Submit drawing", "text": "Send STEP, IGES, DWG or DXF plus substrate, throughput and hygiene grade." },
          { "@type": "HowToStep", "position": 2, "name": "DFM review", "text": "Engineering team proposes steel grade and edge geometry within 1 business day." },
          { "@type": "HowToStep", "position": 3, "name": "Sample and field trial", "text": "Prototype runs for 2— weeks on the customer line; we iterate up to twice." },
          { "@type": "HowToStep", "position": 4, "name": "Production", "text": "5— weeks lead time on a dedicated 5-axis grinding cell with backup capacity." },
          { "@type": "HowToStep", "position": 5, "name": "MTC and dispatch", "text": "EN 10204 3.1 Mill Test Certificate and CMM report included with every shipment." }
        ]
      }
    </script>
  </Fragment>

  <Hero
    tagline="Industries Served"
    title="Looking for Industrial Blades? Six Sectors, One Engineering Team"
    subtitle="Each industry carries its own cutting mechanics —web tension, abrasive wear, hygiene grade, throughput. We tune blade geometry and steel grade to match. KAIPU has supplied converters, recyclers and OEMs across four continents since 1998 (ISO 9001:2015 certified since 2015), with a 98 % on-time delivery rate and a standard 5— weeks lead time."
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:mail' },
      { text: 'View Products', href: '/products' },
    ]}
    image={heroImageHtml}
  />

  <Stats
    id="industries-served"
    tagline="Proven track record"
    title="By the numbers, across six industries"
    subtitle="Quantified production data, not marketing copy. Updated quarterly from our internal quality dashboard."
    stats={stats}
  />

  <Features
    id="industries"
    tagline="Browse by sector"
    title="Pick the industry closest to your line"
    subtitle="Each page documents substrate ranges, material grades, edge preparation and tolerance windows our engineering team has validated in production. If you do not see your cut listed, send us a drawing."
    items={industries.map(({ title, description, icon, href }) => ({
      title,
      description: `${description} <a href="${href}" class="text-primary hover:underline font-semibold">Read more →</a>`,
      icon,
    }))}
    columns={3}
    defaultIcon="tabler:building-factory"
  />

  <section class="not-prose">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16">
      <div class="mb-8 text-center">
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">Industry Comparison</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading dark:text-gray-200 mt-2">
          KAIPU blade envelope, at a glance
        </h2>
        <p class="text-lg text-muted dark:text-slate-300 mt-3 max-w-3xl mx-auto">
          Compared against typical job-shop and overseas-sourced equivalents. All values are production-validated, not theoretical. For a CAD-level quote, send a STEP, IGES or DWG file.
        </p>
      </div>

      <div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm">
        <table class="w-full text-left text-sm md:text-base">
          <thead class="bg-page text-secondary dark:text-blue-200 uppercase text-xs tracking-wider">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Industry</th>
              <th scope="col" class="px-4 py-3 font-semibold">Typical Substrate</th>
              <th scope="col" class="px-4 py-3 font-semibold">Steel Grade</th>
              <th scope="col" class="px-4 py-3 font-semibold">Hardness</th>
              <th scope="col" class="px-4 py-3 font-semibold">Throughput</th>
              <th scope="col" class="px-4 py-3 font-semibold">Edge Life</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
            {comparisonRows.map((row) => (
              <tr class="bg-page">
                <td class="px-4 py-3 font-semibold">{row.industry}</td>
                <td class="px-4 py-3 text-muted dark:text-slate-300">{row.substrate}</td>
                <td class="px-4 py-3 text-muted dark:text-slate-300">{row.grade}</td>
                <td class="px-4 py-3 text-muted dark:text-slate-300">{row.hardness}</td>
                <td class="px-4 py-3 text-muted dark:text-slate-300">{row.throughput}</td>
                <td class="px-4 py-3 text-muted dark:text-slate-300">{row.edge}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-xs text-muted dark:text-slate-400 mt-4 text-center">
        Standards referenced: <a href="https://www.astm.org/a0681_a0681m-20.html" target="_blank" rel="noopener" class="text-primary hover:underline">ASTM A681</a>,
        <a href="https://www.iso.org/standard/62023.html" target="_blank" rel="noopener" class="text-primary hover:underline ml-1">ISO 9001:2015</a>,
        <a href="https://www.en-standard.eu/bs-en-10204-2004-metallic-products-types-of-inspection-documents/" target="_blank" rel="noopener" class="text-primary hover:underline ml-1">EN 10204</a>.
      </p>
    </div>
  </section>

  <Steps
    id="process"
    tagline="How we work"
    title="From drawing to dispatch, in six steps"
    subtitle="A documented process that our engineering team has run on more than 10,000 production runs since 1998. Every step is auditable, every step has a backup plan."
    items={processSteps}
    defaultIcon="tabler:check"
  />

  <FAQs
    id="faq"
    tagline="Frequently asked"
    title="Cross-industry questions, answered"
    subtitle="If your question is industry-specific, follow the link to that sector page for the relevant Q&A. All answers are reviewed by our engineering team each quarter."
    items={faqs}
    columns={2}
  />

  <section class="not-prose">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
      <div class="mb-6 text-center">
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">Proprietary framework</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading dark:text-gray-200 mt-2">{framework.title}</h2>
      </div>

      <div class="rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm p-6 md:p-8">
        <p class="text-base md:text-lg text-muted dark:text-slate-300" set:html={framework.body} />

        <h3 class="text-lg font-bold mt-6 mb-3 dark:text-gray-200">What every quote includes</h3>
        <ul class="list-disc pl-6 space-y-2 text-muted dark:text-slate-300">
          <li>Written DFM review with steel grade and edge geometry rationale, returned within 1 business day.</li>
          <li>Mill Test Certificate per <a href="https://www.en-standard.eu/bs-en-10204-2004-metallic-products-types-of-inspection-documents/" target="_blank" rel="noopener" class="text-primary hover:underline">EN 10204 3.1</a> with every production batch.</li>
          <li>CMM dimensional report from a HEXAGON Global S coordinate measuring machine.</li>
          <li>Hardness survey per Rockwell C with three-point mapping on every blade.</li>
          <li>12-month edge-life guarantee on catalog geometries; Cpk ≥ 1.33 on custom critical dimensions.</li>
        </ul>
      </div>
    </div>
  </section>

  <CallToAction
    title="Not sure which sector fits your cut?"
    subtitle="Send a drawing or a worn sample and our engineering team will classify the application and recommend the steel grade, edge preparation and tolerance window within one business day."
    actions={[
      { variant: 'primary', text: 'Submit a drawing', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'View Solutions', href: '/solutions' },
    ]}
  />
</Layout>