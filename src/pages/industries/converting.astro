---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Converting Blades 鈥?Trim and Score Knives for Pouch, Label and Tape Lines',
  description:
    'Trim and score blades for pouch-making, label-stock and adhesive-tape converting lines. Repeatable edge profile with run-out controlled to 鈮?0.01 mm on 脴 250 mm blanks. M2 HSS and tungsten carbide available.',
};

const heroImageHtml =
  '<img src="/images/industries/converting/trim-score-line-overview.jpg" alt="Trim and score blades on a pouch converting line (placeholder)" class="mx-auto rounded-md w-full" width="1024" height="576" loading="eager" />';

const processImageHtml =
  '<img src="/images/industries/converting/score-geometry-diagram.jpg" alt="Trim and score geometry working principle (placeholder)" class="mx-auto w-full rounded-lg shadow-lg" width="500" height="500" loading="lazy" />';

const features = [
  {
    title: 'Line applications',
    description:
      'Stand-up pouch (SUP), flat-bottom pouch, label-stock sheeting, adhesive-tape cut-to-length, lidding film, medical pouch, and personal-care product converting. Trim, score and perforating geometries supplied as matched sets.',
    icon: 'tabler:layout',
  },
  {
    title: 'Score geometry',
    description:
      'Score depth 0.05 鈥?0.50 mm controlled to 卤 0.01 mm, score angle 30掳鈥?0掳, score width 0.2 鈥?1.5 mm. Perforating rule teeth-per-inch 4鈥?2 TPI, manufactured to OEM pattern. Edge profile verified on optical comparator before dispatch.',
    icon: 'tabler:ruler',
  },
  {
    title: 'Run-out control',
    description:
      'Run-out (TIR) controlled to 鈮?0.01 mm on 脴 250 mm blanks. This is the tolerance that drives clean trim edges on multi-lane label lines and prevents web wander at the score station on high-speed pouch lines.',
    icon: 'tabler:rotate-clockwise',
  },
  {
    title: 'Material grades',
    description:
      'M2 high-speed steel (1.3343) for high-volume trim and score; D2 (1.2379) for general-purpose cut-to-length. Tungsten carbide grades available for abrasive adhesive or coated substrates where steel wears too quickly.',
    icon: 'tabler:certificate',
  },
  {
    title: 'Tolerances and finish',
    description:
      'OD 卤 0.005 mm, ID H6 or H7 fit, thickness 卤 0.005 mm. Surface roughness 鈮?Ra 0.2 碌m on the cutting edge, 鈮?Ra 0.4 碌m on the body. Dynamic balance to G2.5 at operating RPM supplied for high-speed rotors.',
    icon: 'tabler:ruler-measure',
  },
  {
    title: 'Regrind and repeatability',
    description:
      'Multi-index knives supplied with up to 4 cutting edges per blade. Edge profile repeatable to within 卤 0.005 mm across all indexes, so a blade swap does not require re-tensioning of the web or re-calibration of the score depth.',
    icon: 'tabler:refresh',
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Converting"
    title="Trim and Score Blades for Pouch, Label and Tape Lines"
    subtitle="Repeatable edge profile across production shifts, with run-out controlled to 鈮?0.01 mm on 脴 250 mm blanks. M2 HSS, D2 and tungsten carbide grades available; matched sets shipped with optical comparator reports."
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:mail' },
      { text: 'View Serrated Blades', href: '/products/serrated/' },
    ]}
    image={heroImageHtml}
  />

  <Content
    id="how-it-works"
    tagline="Working principle"
    title="How trim and score cuts clean at 800 m/min"
    subtitle="Converting tooling is judged by the second hour of the shift, not the first minute. Geometry choice, score depth and registration are dictated by substrate, web tension and line speed."
    content={`
      <p>
        Converting lines cut multi-layer substrates in a single pass. The blade pair has to separate paper from film from adhesive without lifting, tearing or leaving adhesive residue on the cut edge. Edge preparation controls this more than steel grade does.
      </p>
      <p class="mt-4">
        The two failure modes we see most often 鈥?adhesive build-up on the edge and score-depth drift across the shift 鈥?both trace back to the same root cause: the score geometry was specified for the wrong substrate stack.
      </p>
    `}
    items={[
      {
        title: 'Edge profile and burr control',
        description: 'Edge radius selected per substrate: sharp < 5 碌m for film, light hone 5鈥?5 碌m for paper, micro-hone 25鈥?5 碌m for abrasive stocks. Burr kept below 25 碌m on the cut edge.',
        icon: 'tabler:blade',
      },
      {
        title: 'Run-out (TIR) on circular slitters',
        description: 'Run-out held to 鈮?0.01 mm on 脴 250 mm blanks. This drives clean trim edges on multi-lane label lines and prevents web wander at the score station.',
        icon: 'tabler:rotate-clockwise',
      },
      {
        title: 'Registration and repeatability',
        description: 'Multi-index knives carry identical geometry across all four indexes (卤 0.005 mm), so a blade swap does not require re-tensioning of the web or re-calibration of the score depth.',
        icon: 'tabler:layout-grid',
      },
    ]}
    image={processImageHtml}
  />

  <Features
    id="capabilities"
    tagline="Engineering scope"
    title="Six specification levers for converting lines"
    subtitle="Converting tooling is judged by the second hour of the shift, not the first minute. Each variable below is selected for run-to-run consistency, not point-of-sale price."
    items={features}
    columns={3}
    defaultIcon="tabler:layout"
  />

  <CallToAction
    title="Specifying trim or score tooling?"
    subtitle="Send the OEM machine model, current knife grade, target line speed and the substrate mix (film, foil, laminate, paper). We will return a written quote with material, tolerance and regrind plan within one business day."
    actions={[
      { variant: 'primary', text: 'Submit a drawing', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'Browse Solutions', href: '/solutions' },
    ]}
  />
</Layout>