---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Plastics Recycling Blades 鈥?Granulator and Shredder Rotor / Stator Knives',
  description:
    'Granulator and shredder rotor / stator knives for plastics recycling. D2, SKD11 and M2 HSS grades, optional TiN / CrN PVD coating to extend service interval 2鈥?脳 on glass-fibre and contaminated feedstock.',
};

// Image html strings 鈥?same pattern as src/pages/index.astro `heroImageHtml`.
// SVG placeholders live under `public/` and are referenced by absolute path.
// Replace the `src` attribute (or replace the .svg file in place) to swap in
// real artwork without touching this template.
const heroImageHtml =
  '<img src="/images/industries/plastics-recycling/granulator-rotor-knife.jpg" alt="Granulator rotor knives in a plastics-recycling line (placeholder)" class="mx-auto rounded-md w-full" width="1024" height="576" loading="eager" />';

const rotorImageHtml =
  '<img src="/images/industries/plastics-recycling/shear-principle-diagram.jpg" alt="Granulator rotor principle diagram (placeholder)" class="mx-auto w-full rounded-lg shadow-lg" width="500" height="500" loading="lazy" />';

const features = [
  {
    title: 'Substrate range',
    description:
      'PET, HDPE, LDPE, PP, PA66 and other engineering polymers, including glass-fibre reinforced grades up to 50 % GF, mineral-filled compounds, and post-consumer feedstock with contamination (paper labels, metal specks, abrasive fines).',
    icon: 'tabler:recycle',
  },
  {
    title: 'Rotor / stator configurations',
    description:
      'Standard 3- and 5-blade rotor sets with matching bed knives. Open-rotor (cut-and-throw) and closed-rotor (scissor-cut) geometries. V-cut and claw profiles for shredders. Knife seat and slot dimensions to OEM specification.',
    icon: 'tabler:settings',
  },
  {
    title: 'Material grades',
    description:
      'D2 (1.2379 / SKD11) for general-purpose cutting, M2 high-speed steel (1.3343) for impact-loaded rotors. Hardness HRC 58鈥?2 D2, HRC 60鈥?4 M2. Vacuum heat-treatment with double-temper for dimensional stability.',
    icon: 'tabler:certificate',
  },
  {
    title: 'PVD coating options',
    description:
      'TiN, TiCN and CrN coatings per ISO 14574 extend service interval 2鈥?脳 on glass-fibre and mineral-filled feedstock. CrN preferred for high-temperature reclaim lines. Coating thickness 2鈥? 碌m, applied after final grind.',
    icon: 'tabler:shield',
  },
  {
    title: 'Hook and clearance angles',
    description:
      'Hook angle 8掳鈥?5掳 for general-purpose, 18掳鈥?2掳 for high-throughput reclaim. Clearance angle 2掳鈥?掳 rotor, 3掳鈥?掳 bed knife. Aggressive angles on contaminated feedstock; conservative angles on glass-fibre to limit chipping.',
    icon: 'tabler:blade',
  },
  {
    title: 'Tolerances and regrind',
    description:
      'Standard 卤 0.01 mm thickness, 卤 0.02 mm length, parallelism 0.02 mm across the cutting edge. Up to 4 regrinds permitted on standard D2 knives before the cutting edge falls below OEM geometry. Regrind service available in-house.',
    icon: 'tabler:ruler-measure',
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Plastics Recycling"
    title="Granulator and Shredder Rotor / Stator Knives"
    subtitle="Engineered to cut through contamination, glass fibre and reinforced polymers. D2 and M2 HSS options, with optional TiN or CrN PVD coating to extend service interval by 2鈥?脳 on the same line."
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:mail' },
      { text: 'View Granulator Blades', href: '/products/granulator/' },
    ]}
    image={heroImageHtml}
  />

  <Content
    id="rotor-principle"
    tagline="Working principle"
    title="How the rotor-stator shear cut works"
    subtitle="Open-rotor and closed-rotor geometries cut by impact shear, not by slicing. The geometry choice, hook angle and clearance angle are dictated by substrate, throughput and contamination class."
    content={`
      <p>
        A granulator rotor carries a ring of knives rotating past a stationary bed knife. Material enters the cutting gap and is sheared by impact, not by the kind of clean slicing a slitter performs.
        Open-rotor (cut-and-throw) geometries push the cut product out of the cutting chamber with the same rotation; closed-rotor (scissor-cut) geometries rely on a downstream screen to size the output.
      </p>
      <p class="mt-4">
        The two failure modes we see most often 鈥?micro-chipping on glass-fibre and progressive welding on sticky polymer 鈥?both trace back to the same root cause: edge preparation and clearance angle were specified for the wrong substrate family.
      </p>
    `}
    items={[
      {
        title: 'Open rotor (cut-and-throw)',
        description: '3 or 5 blades. Lower friction, higher throughput. Best for film, fibre, low-density feedstock.',
        icon: 'tabler:circle-arrow-right',
      },
      {
        title: 'Closed rotor (scissor-cut)',
        description: '3 or 5 blades + matched bed. Cleaner cut, tighter granulate. Best for rigid plastic and engineering polymer.',
        icon: 'tabler:cut',
      },
      {
        title: 'V-cut / claw profile',
        description: 'For shredders. Aggressive bite on bulky post-consumer parts and purgings.',
        icon: 'tabler:bolt',
      },
    ]}
    image={rotorImageHtml}
  />

  <Features
    id="capabilities"
    tagline="Engineering scope"
    title="Six specification levers for plastics recycling"
    subtitle="Recycling lines are abrasive, impact-loaded and inconsistent. Each variable below is selected against substrate, throughput and contamination class 鈥?not against the cheapest steel on the shelf."
    items={features}
    columns={3}
    defaultIcon="tabler:recycle"
  />

  <CallToAction
    title="Specifying granulator or shredder knives?"
    subtitle="Send the OEM model, rotor diameter, current knife grade and the typical feedstock mix. We will return a written quote with material, hardness, coating option and expected service interval within one business day."
    actions={[
      { variant: 'primary', text: 'Submit a drawing', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'Browse Solutions', href: '/solutions' },
    ]}
  />
</Layout>