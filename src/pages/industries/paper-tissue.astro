---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import PrecisionCta from '~/components/widgets/PrecisionCta.astro';

const metadata = {
  title: 'Paper & Tissue Machine Knives',
  description:
    'Bed knives and top blades for paper and tissue converting at 600–2,400 m/min. D2 / SKD11 bed (HRC 58–62), M2 HSS top (HRC 60–64). Optimised shear angles reduce dust.',
};

const heroImage = { src: "/images/industries/paper-tissue/tissue-line-overview.webp", alt: "Bed knife and top blade pair on a tissue converting line" };

const processImage = { src: "/images/industries/paper-tissue/bed-knife-detail.webp", alt: "Tissue bed-knife and top-blade cutting mechanics" };

const features = [
  {
    title: 'Tissue grammage range',
    description:
      'Validated on 1-ply, 2-ply and 3-ply tissue at 13–30 gsm per ply, including through-air-dried (TAD) and conventional pressed sheets. Bed-knife / top-blade pair geometry tuned to ply count and bonding pattern.',
    icon: 'tabler:stack-2',
  },
  {
    title: 'Line speed envelope',
    description:
      'Production-validated on tissue lines running 600–2,400 m/min. Higher speeds require tighter angular control on the bed-knife seat and stricter flatness on the top blade —both verified on the CMM before dispatch.',
    icon: 'tabler:player-track-next',
  },
  {
    title: 'Cutting angle optimisation',
    description:
      'Bed-knife shear angle and top-blade clearance optimised per OEM (typically 20°–24° shear, 0.5°–1.5° clearance). Correct angles reduce dust generation and extend regrind interval by 30–50 % versus generic tooling.',
    icon: 'tabler:blade',
  },
  {
    title: 'Material grades',
    description:
      'D2 (1.2379) and SKD11 for bed knives; M2 high-speed steel (1.3343) for top blades where impact loading is high. Hardness HRC 58–62 bed, HRC 60–64 top. Optional TiN or CrN PVD coating on abrasive furnish.',
    icon: 'tabler:certificate',
  },
  {
    title: 'Tolerances and flatness',
    description:
      'Bed-knife flatness ≥0.02 mm across the full cutting length (typically 2,000–4,200 mm). Top-blade thickness ± 0.005 mm, parallel within 0.01 mm. CMM reports available with every shipment.',
    icon: 'tabler:ruler-measure',
  },
  {
    title: 'Service interval extension',
    description:
      'Common service interval on premium uncoated D2 bed knives is 8–14 weeks on 2-ply tissue. PVD-coated sets typically run 14–22 weeks on the same lines. Intervals quoted against a reference substrate and shift count.',
    icon: 'tabler:clock',
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Paper & Tissue"
    title="Machine Knives for Paper & Tissue Converting"
    subtitle="Long-life tooling for tissue converting lines running 600–2,400 m/min. Optimised cutting angles reduce dust and extend service intervals —typically 8–14 weeks uncoated, 14–22 weeks PVD-coated on 2-ply stock."
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:mail' },
      { text: 'View Straight Blades', href: '/products/straight/' },
    ]}
    image={heroImage}
  />

  <Content
    id="cutting-mechanics"
    tagline="Cutting mechanics"
    title="How tissue lines cut 2-ply without dusting"
    subtitle="At 1,800 m/min the cut is happening 30 times per second across the bed-knife length. Dust, edge wear and ply separation are symptoms of bed-knife geometry drifting out of spec."
    content={`
      <p>
        Tissue cutting is a controlled shear between a stationary bed knife and a rotating top blade. The two blades meet at a precise angle, with a precise clearance, and the ply stack passes between them. The cut is so fast that any geometry drift shows up as dust within minutes, not shifts.
      </p>
      <p class="mt-4">
        The two failure modes we see most often —dust generation and ply separation —both trace back to the same root cause: the bed-knife shear angle drifted outside the 20°–24° window, or the top-blade clearance drifted outside 0.5°–1.5°.
      </p>
    `}
    items={[
      {
        title: 'Shear angle and clearance',
        description: 'Bed-knife shear angle 20°–24°, top-blade clearance 0.5°–1.5° per OEM. Correct angles reduce dust generation by 30–50 % and extend regrind interval over generic tooling.',
        icon: 'tabler:blade',
      },
      {
        title: 'Bed-knife flatness',
        description: 'Bed-knife flatness ≥0.02 mm across the full cutting length (typically 2,000–4,200 mm). Granite-plate-verified before dispatch.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'Hardness pair for impact loading',
        description: 'D2 / SKD11 bed knives at HRC 58–62; M2 HSS top blades at HRC 60–64 where impact loading is high. TiN or CrN PVD coating on abrasive furnish.',
        icon: 'tabler:certificate',
      },
    ]}
    image={processImage}
  />

  <Features
    id="capabilities"
    tagline="Engineering scope"
    title="Six specification levers for tissue converting"
    subtitle="Tissue lines punish generic knives. Each variable below is specified as a number against an international standard, then verified on the part before it leaves the shop."
    items={features}
    columns={3}
    defaultIcon="tabler:toilet-paper"
  />

  <!-- Precision-engineering CTA closer -->
  <PrecisionCta
    id="paper-tissue-cta-case"
    eyebrow="Documented Case Study"
    title={`<span class="block text-white">1200 m/min 4-ply tissue</span><span class="mt-1 block bg-clip-text text-transparent" style="background-image: linear-gradient(90deg, #fb923c 0%, #f59e0b 50%, #fbbf24 100%);">case study.</span>`}
    subtitle="See how a 15 µm micro-hone combined with an 18° clearance angle extended bed-knife service life from 11 days to 34 days at 1200 m/min on 4-ply tissue —with the D2 grade and HRC 60 unchanged."
    primaryAction={{ text: 'Read the case study', href: '/products/straight/bed-knife-tissue/' }}
    secondaryAction={{ text: 'Request a Quote', href: '/contact', isMailto: false }}
    trustItems={[
      '11 → 34 day service life',
      'D2 grade · HRC 60 unchanged',
      '15 µm micro-hone · 18° clearance',
    ]}
    cardEyebrow="Job #PT-2026"
    cardCaption="baseline 11 d → micro-hone + clearance → 34 d service life"
  />

  <!-- Precision-engineering CTA closer -->
  <PrecisionCta
    id="paper-tissue-cta-tooling"
    eyebrow="Tissue Bed-Knife Tooling"
    title={`<span class="block text-white">Need tissue bed-knife</span><span class="mt-1 block bg-clip-text text-transparent" style="background-image: linear-gradient(90deg, #fb923c 0%, #f59e0b 50%, #fbbf24 100%);">or top-blade tooling?</span>`}
    subtitle="Send the OEM machine model, current knife geometry and target service interval. We will return a written quotation with material grade, hardness, tolerance and lead time within one business day."
    primaryAction={{ text: 'Submit a drawing', href: '/contact' }}
    secondaryAction={{ text: 'Browse Solutions', href: '/solutions', isMailto: false }}
    trustItems={[
      'OEM machine model quoting',
      'Service-interval target analysis',
      'Hardness + tolerance to spec',
    ]}
    cardEyebrow="Job #PT-2026"
    cardCaption="machine + geometry → grade + hardness + tolerance quote"
  />
</Layout>