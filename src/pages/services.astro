---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';

import { capabilities } from '~/data/services-capabilities';
import { processSteps } from '~/data/services-steps';
import { faqs } from '~/data/services-faqs';

const metadata = {
  title: 'Custom Blade Manufacturing Services',
  description:
    'OEM / ODM custom blade manufacturing services. Design, CNC grinding, vacuum heat treatment, PVD coating (TiN / TiCN / CrN / DLC), CMM inspection and global logistics.',
};

const heroImage = { src: "/images/services/manufacturing-service-operations.webp", alt: "Custom Machine Knives manufacturing service operations" };

const lastUpdated = '2026-09-11';
const publishedDate = '2026-01-15';
const foundedYear = 2008;
const yearsInBusiness = new Date().getFullYear() - foundedYear;
const siteUrl = 'https://custommachineknives.com';
---

<Layout metadata={{ ...metadata, dateModified: lastUpdated, datePublished: publishedDate }}>
  <!-- 1. HERO -->
  <Hero
    tagline="Manufacturing Services"
    title="Custom Machine Knife Manufacturing Services"
    subtitle={`Custom Machine Knives operates the design office, tool-room, heat treatment, surface coating and quality lab under one roof. ${yearsInBusiness} years of industrial-blade manufacturing since ${foundedYear}, one engineering team end-to-end.`}
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'View Products', href: '/products' },
    ]}
    image={heroImage}
  />

  <!-- 2. AWARENESS STRIP (awareness / yearsInBusiness / uniqueDataPoint) -->
  <section class="px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-5xl rounded-lg border border-slate-200 p-6 shadow-sm md:p-8 dark:border-slate-700">
      <p class="text-base leading-relaxed md:text-lg">
        Looking for a blade manufacturer who can take a worn sample and ship a re-engineered part within weeks —not months? Most job shops will ask you to redraw it. We measure, reverse-engineer and, in many cases, improve on the original edge geometry. If you need ISO 9001 certified production with documented PPAP and a 5-dimension Quality Gate, you are in the right place.
      </p>
      <ul class="mt-4 grid gap-2 text-sm md:grid-cols-3 md:text-base">
        <li>—<strong>{yearsInBusiness} years</strong> manufacturing blades since {foundedYear}</li>
        <li>—<strong>98% on-time delivery</strong> · 10,000+ custom blades shipped per year</li>
        <li>—<strong>Cpk ≥ 1.33</strong> on critical dimensions, audited quarterly</li>
      </ul>
    </div>
  </section>

  <!-- 3. CAPABILITIES (bestForPattern) -->
  <Features
    id="capabilities"
    tagline="Capabilities"
    title="Six Core Services, In-House"
    subtitle="Each capability is staffed by specialists and supported by calibrated equipment. We do not outsource critical process steps."
    items={capabilities}
  />

  <!-- 4. COMPARISON TABLE (comparison / realTableElement / externalLinks) -->
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">Comparison</p>
        <h2 class="mb-2 text-3xl font-bold md:text-4xl">Custom Machine Knives vs Typical Job Shop</h2>
        <p class="mx-auto max-w-3xl text-base md:text-lg">
          How Custom Machine Knives compares to a typical CNC job shop or overseas OEM. Compared with the alternatives, the difference is in-house control of every critical step —from steel sourcing to final QA documentation.
        </p>
      </div>
      <div class="overflow-x-auto rounded-lg border border-slate-200 shadow-sm dark:border-slate-700">
        <table class="w-full text-left text-sm md:text-base">
          <thead>
            <tr class="border-b border-slate-300 dark:border-slate-600">
              <th class="px-4 py-3 font-semibold">Capability</th>
              <th class="px-4 py-3 font-semibold">Custom Machine Knives</th>
              <th class="px-4 py-3 font-semibold">Typical Job Shop</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-slate-200 dark:border-slate-700"><td class="px-4 py-3 font-medium">Design office in-house</td><td class="px-4 py-3">✓ 3D CAD + FEA on request</td><td class="px-4 py-3">✗ Outsourced</td></tr>
            <tr class="border-b border-slate-200 dark:border-slate-700"><td class="px-4 py-3 font-medium">Vacuum heat treatment</td><td class="px-4 py-3">✓ In-house, ISO 9001 controlled</td><td class="px-4 py-3">✗ Sent out</td></tr>
            <tr class="border-b border-slate-200 dark:border-slate-700"><td class="px-4 py-3 font-medium">PVD coating uniformity</td><td class="px-4 py-3">✓ ±2 µm</td><td class="px-4 py-3">✗ Inconsistent</td></tr>
            <tr class="border-b border-slate-200 dark:border-slate-700"><td class="px-4 py-3 font-medium">Cpk capability</td><td class="px-4 py-3">✓ Cpk ≥ 1.33</td><td class="px-4 py-3">✗ Not reported</td></tr>
            <tr class="border-b border-slate-200 dark:border-slate-700"><td class="px-4 py-3 font-medium">Production capacity lock</td><td class="px-4 py-3">✓ 50,000 pcs / month, backup furnace</td><td class="px-4 py-3">✗ Single shift, no redundancy</td></tr>
            <tr class="border-b border-slate-200 dark:border-slate-700"><td class="px-4 py-3 font-medium">PPAP / ISIR documents</td><td class="px-4 py-3">✓ On request</td><td class="px-4 py-3">✗ Not standard</td></tr>
            <tr><td class="px-4 py-3 font-medium">Lead time (custom)</td><td class="px-4 py-3">✓ 4–6 weeks</td><td class="px-4 py-3">✗ 8–12 weeks</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
        Standards and references:
        <a href="https://www.iso.org/standard/62085.html" class="text-primary underline" rel="noopener noreferrer" target="_blank">ISO 9001:2015</a>,
        <a href="https://www.astm.org/a0681_a0681m-20.html" class="text-primary underline" rel="noopener noreferrer" target="_blank">ASTM A681 (D2 tool steel)</a>,
        <a href="https://www.vdi.de/richtlinien/details/vdi-3198" class="text-primary underline" rel="noopener noreferrer" target="_blank">VDI 3198 coating adhesion</a>,
        <a href="https://www.nadcap.org/" class="text-primary underline" rel="noopener noreferrer" target="_blank">NADCAP</a>-aligned heat treatment.
      </p>
    </div>
  </section>

  <!-- 5. TRUST & CAPACITY STRIP (capacityLock / certification / standardCitation / uniqueDataPoint / proprietaryFrame) -->
  <section class="px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-lg border border-slate-200 p-5 shadow-sm dark:border-slate-700">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">Certification</p>
          <h3 class="mt-2 text-xl font-bold">ISO 9001:2015 Certified</h3>
          <p class="mt-2 text-sm">Quality management system audited annually. PPAP, ISIR and Cpk ≥ 1.33 documentation available on request.</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5 shadow-sm dark:border-slate-700">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">Capacity</p>
          <h3 class="mt-2 text-xl font-bold">50,000 pcs monthly capacity</h3>
          <p class="mt-2 text-sm">3-shift operation with backup vacuum furnace and backup CNC grinder for redundancy. Production volume locked for serial orders.</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5 shadow-sm dark:border-slate-700">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">Quality Framework</p>
          <h3 class="mt-2 text-xl font-bold">5-dimension Quality Gate</h3>
          <p class="mt-2 text-sm">Every blade passes 5 dimensions of verification: material, geometry, hardness, surface finish, and Cpk ≥ 1.33 process capability.</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5 shadow-sm dark:border-slate-700">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">Standards</p>
          <h3 class="mt-2 text-xl font-bold">ASTM A681 · ISO 9001 · VDI 3198</h3>
          <p class="mt-2 text-sm">Material per ASTM A681 (D2 tool steel), heat treatment per NADCAP-aligned ISO 9001 quality system, coating adhesion per VDI 3198.</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5 shadow-sm dark:border-slate-700">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">Experience</p>
          <h3 class="mt-2 text-xl font-bold">Manufacturing blades since 2008</h3>
          <p class="mt-2 text-sm">{yearsInBusiness} years supplying automotive, packaging, converting, metalworking and recycling customers worldwide.</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5 shadow-sm dark:border-slate-700">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">Track Record</p>
          <h3 class="mt-2 text-xl font-bold">98% on-time · 10,000+ / year</h3>
          <p class="mt-2 text-sm">Custom-blade delivery performance audited by SQE on a quarterly basis. Cpk ≥ 1.33 reported per batch.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. PROCESS STEPS (headingNumbered / HowTo) -->
  <Steps id="process" title="Eight Steps from RFQ to Delivery" tagline="Order Process" items={processSteps} />

  <!-- 7. FAQ (faqResolution / faqHtmlPattern / bulletOrStepList) -->
  <section id="maintenance" class="px-4 py-12 sm:px-6 scroll-mt-[72px]">
    <div class="mx-auto max-w-4xl">
      <div class="mb-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">FAQ</p>
        <h2 class="mb-2 text-3xl font-bold md:text-4xl">Frequently Asked Questions</h2>
        <p class="text-base md:text-lg">
          Buyer questions about lead times, MOQ, NDA, samples, payment terms, PPAP and shipping. Not seeing your question here? Send it to our engineering team.
        </p>
      </div>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="rounded-lg border border-slate-200 p-5 shadow-sm dark:border-slate-700">
            <summary class="cursor-pointer text-lg font-semibold">{faq.q}</summary>
            <div class="mt-3 text-sm md:text-base">
              <p>{faq.a}</p>
              {faq.bullets && (
                <ul class="mt-2 list-disc pl-6">
                  {faq.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. CALL TO ACTION — Precision-engineering dark section, bespoke to /services/ -->
  <section
    id="services-cta"
    class="relative isolate overflow-hidden"
    aria-labelledby="services-cta-heading"
  >
    <!-- Layer 1: deep steel-blue gradient (token-driven, dark + light mode aware) -->
    <div
      class="absolute inset-0 -z-30"
      style="background: var(--aw-gradient-deep);"
      aria-hidden="true"
    ></div>

    <!-- Layer 2: 40px CAD grid texture (faint white lines, only ~5% alpha — reads as substrate, not wallpaper) -->
    <div
      class="absolute inset-0 -z-20 opacity-[0.05]"
      aria-hidden="true"
      style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 40px 40px;"
    ></div>

    <!-- Layer 3: single warm radial accent (replaces the amateur outer-glow on the button) -->
    <div
      class="absolute -bottom-32 -right-24 -z-10 h-80 w-80 rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(closest-side, var(--aw-color-accent) 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 md:px-6 md:py-28">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-10 lg:gap-14 md:items-center">
        <!-- LEFT COLUMN — copy + CTAs (7/12) -->
        <div class="md:col-span-7 text-left">
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 font-mono text-[11px] uppercase tracking-[0.18em] text-orange-300 backdrop-blur-sm">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-orange-400"></span>
            Re-Engineering Service
          </p>

          <h2
            id="services-cta-heading"
            class="font-heading text-4xl font-bold leading-[1.05] tracking-tight md:text-5xl lg:text-[3.75rem]"
          >
            <span class="block text-white">No drawing?</span>
            <span
              class="mt-1 block bg-clip-text text-transparent"
              style="background-image: linear-gradient(90deg, #fb923c 0%, #f59e0b 50%, #fbbf24 100%);"
            >
              Send the broken blade.
            </span>
          </h2>

          <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-300 md:text-lg">
            For re-engineering work we can measure your worn blade and reproduce the original geometry —often improving on it based on what we see in the wear pattern.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:gap-4">
            <!-- Primary CTA: solid orange, hard shadow, no outer glow, right arrow -->
            <a
              href="/contact"
              class="group inline-flex items-center justify-center gap-2 rounded-lg px-7 py-3.5 text-base font-semibold text-white shadow-md shadow-orange-950/40 ring-1 ring-inset ring-orange-700/30 transition-all duration-200 hover:shadow-lg hover:shadow-orange-950/50 hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
              style="background-image: linear-gradient(180deg, #f97316 0%, #ea580c 100%);"
            >
              <span>Send Your Drawing</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="M13 6l6 6-6 6" />
              </svg>
            </a>

            <!-- Secondary CTA: ghost style, semi-transparent dark border -->
            <a
              href="mailto:[email protected]"
              class="group inline-flex items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/[0.03] px-7 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:border-white/30 hover:bg-white/[0.07] focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 text-slate-300 transition-colors group-hover:text-white"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M3 7l9 6 9-6" />
              </svg>
              <span>Email Engineering</span>
            </a>
          </div>

          <!-- Trust micro-row -->
          <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-400">
            <li class="inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
              CMM-measured reverse engineering
            </li>
            <li class="inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
              Geometry upgrade on request
            </li>
            <li class="inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
              NDA on first email
            </li>
          </ul>
        </div>
        <!-- RIGHT COLUMN — glass card with CAD wireframe illustration (5/12) -->
        <div class="md:col-span-5">
          <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] p-5 shadow-2xl shadow-slate-950/60 backdrop-blur-md md:p-6">

            <!-- CAD corner registration ticks (orange) -->
            <span class="absolute left-3 top-3 h-3 w-3 border-l border-t border-orange-400/70" aria-hidden="true"></span>
            <span class="absolute right-3 top-3 h-3 w-3 border-r border-t border-orange-400/70" aria-hidden="true"></span>
            <span class="absolute left-3 bottom-3 h-3 w-3 border-l border-b border-orange-400/70" aria-hidden="true"></span>
            <span class="absolute right-3 bottom-3 h-3 w-3 border-r border-b border-orange-400/70" aria-hidden="true"></span>

            <!-- Card header — CAD inspector toolbar -->
            <div class="mb-4 flex items-center justify-between">
              <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.2em] text-slate-400">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-orange-400"></span>
                Job #RE-2026
              </div>
              <span class="rounded-sm border border-orange-400/30 bg-orange-500/10 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.2em] text-orange-300">
                scan mode
              </span>
            </div>

            <!-- Wireframe illustration viewport -->
            <div class="relative aspect-[4/3] overflow-hidden rounded-lg border border-white/5 bg-gradient-to-br from-slate-950/60 to-slate-900/30">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="absolute inset-0 h-full w-full"
                viewBox="0 0 200 150"
                fill="none"
                aria-hidden="true"
              >
                <defs>
                  <pattern id="cta-micro-grid" width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="0.3" />
                  </pattern>
                </defs>

                <!-- micro grid substrate -->
                <rect width="200" height="150" fill="url(#cta-micro-grid)" />

                <!-- center crosshairs (dashed) -->
                <line x1="100" y1="0" x2="100" y2="150" stroke="rgba(255,255,255,0.18)" stroke-width="0.4" stroke-dasharray="2 3" />
                <line x1="0" y1="75" x2="200" y2="75" stroke="rgba(255,255,255,0.18)" stroke-width="0.4" stroke-dasharray="2 3" />

                <!-- outer blade wireframe -->
                <circle cx="100" cy="75" r="44" stroke="rgba(251,146,60,0.95)" stroke-width="1.2" fill="none" />
                <!-- mid dashed circle -->
                <circle cx="100" cy="75" r="30" stroke="rgba(251,146,60,0.55)" stroke-width="0.7" fill="none" stroke-dasharray="3 2" />
                <!-- inner bevel hint -->
                <circle cx="100" cy="75" r="16" stroke="rgba(251,146,60,0.35)" stroke-width="0.6" fill="none" />

                <!-- center bore -->
                <circle cx="100" cy="75" r="6" stroke="rgba(255,255,255,0.75)" stroke-width="0.6" fill="none" />
                <circle cx="100" cy="75" r="1.4" fill="rgba(255,255,255,0.85)" />

                <!-- top dimension line + label -->
                <line x1="56" y1="20" x2="144" y2="20" stroke="rgba(148,163,184,0.55)" stroke-width="0.4" />
                <line x1="56" y1="17" x2="56" y2="23" stroke="rgba(148,163,184,0.55)" stroke-width="0.4" />
                <line x1="144" y1="17" x2="144" y2="23" stroke="rgba(148,163,184,0.55)" stroke-width="0.4" />
                <text x="100" y="14" font-family="ui-monospace, monospace" font-size="6" fill="rgba(203,213,225,0.95)" text-anchor="middle">&#216; 88.00 &#177; 0.02</text>

                <!-- right radial arc + label -->
                <path d="M 144 75 A 44 44 0 0 0 134.4 49.5" stroke="rgba(96,165,250,0.55)" stroke-width="0.4" fill="none" />
                <text x="150" y="65" font-family="ui-monospace, monospace" font-size="5" fill="rgba(147,197,253,0.95)">R44</text>

                <!-- scan beam -->
                <line x1="22" y1="20" x2="62" y2="58" stroke="rgba(96,165,250,0.55)" stroke-width="0.5" stroke-dasharray="2 2" />
                <circle cx="62" cy="58" r="1.6" fill="rgba(96,165,250,0.95)" />
              </svg>

              <!-- HUD overlay: top-left scanning indicator -->
              <div class="absolute left-2 top-2 flex items-center gap-1 rounded border border-blue-400/20 bg-slate-950/70 px-1.5 py-0.5 font-mono text-[9px] text-blue-300 backdrop-blur-sm">
                <span class="inline-block h-1 w-1 animate-pulse rounded-full bg-blue-400"></span>
                SCANNING
              </div>

              <!-- HUD overlay: bottom-right measurement chip -->
              <div class="absolute bottom-2 right-2 rounded border border-orange-400/20 bg-slate-950/70 px-2 py-0.5 font-mono text-[9px] text-orange-300 backdrop-blur-sm">
                &#216; 88.00 &#177; 0.02 mm
              </div>
            </div>

            <!-- Spec footer — three monospace data tiles -->
            <div class="mt-5 grid grid-cols-3 gap-2 text-center">
              <div class="rounded-md border border-white/5 bg-white/[0.02] px-2 py-2.5">
                <div class="font-mono text-sm font-semibold text-white">0.01</div>
                <div class="mt-0.5 font-mono text-[9px] uppercase tracking-wider text-slate-400">mm tol.</div>
              </div>
              <div class="rounded-md border border-white/5 bg-white/[0.02] px-2 py-2.5">
                <div class="font-mono text-sm font-semibold text-white">CMM</div>
                <div class="mt-0.5 font-mono text-[9px] uppercase tracking-wider text-slate-400">verified</div>
              </div>
              <div class="rounded-md border border-orange-400/20 bg-orange-500/[0.06] px-2 py-2.5">
                <div class="font-mono text-sm font-semibold text-orange-300">5 wk</div>
                <div class="mt-0.5 font-mono text-[9px] uppercase tracking-wider text-slate-400">lead</div>
              </div>
            </div>
          </div>

          <!-- caption under the card -->
          <p class="mt-3 text-center font-mono text-[11px] text-slate-500">
            worn blade &rarr; CMM scan &rarr; drawing &rarr; OEM-match or upgrade
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. LAST UPDATED FOOTER (freshnessDate) -->
  <div class="px-4 py-6 text-center text-xs text-slate-500 sm:px-6 dark:text-slate-400">
    Last updated: {lastUpdated} · Originally published: {publishedDate} · Manufacturing blades since 2008
  </div>

  <!-- 10. JSON-LD BLOCKS (schemaOrg / faqSchema / breadcrumbSchema / productSchema / howToSchema) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Custom Industrial Blade Manufacturing',
    provider: { '@type': 'Organization', name: 'Custom Machine Knives' },
    areaServed: 'Worldwide',
    serviceType: 'OEM/ODM blade manufacturing',
    description: 'Custom blade design, CNC grinding, vacuum heat treatment, PVD coating and precision QA under one roof.',
