---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Manufacturing Services',
  description:
    'OEM / ODM blade manufacturing services: custom design, CNC grinding, vacuum heat treatment, PVD coating, precision QA and global logistics.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Manufacturing Services"
    title="From Drawing to Dispatch — One Source"
    subtitle="KAIPU operates the design office, tool-room, heat treatment, surface coating and quality lab under one roof. You deal with one engineering team end-to-end."
    actions={[
      {
        variant: 'primary',
        text: 'Request a Quote',
        href: '/contact',
        icon: 'tabler:clipboard-text',
      },
      { text: 'View Products', href: '/products' },
    ]}
  />

  <Features
    id="capabilities"
    tagline="Capabilities"
    title="Six Core Services, In-House"
    subtitle="Each capability is staffed by specialists and supported by calibrated equipment. We do not outsource critical process steps."
    items={[
      {
        title: 'Custom Blade Design',
        description:
          'Reverse-engineering from a worn sample, parametric design from your drawing, or co-development against a new process. 3D CAD, FEA on request.',
      },
      {
        title: 'CNC Precision Grinding',
        description:
          '5-axis CNC profile grinding, surface grinding to Ra 0.2 µm, OD/ID cylindrical grinding, and CNC wire EDM for carbide geometries.',
      },
      {
        title: 'Vacuum Heat Treatment',
        description:
          'Vacuum hardening, tempering and sub-zero treatment. Hardness verified on every batch with calibrated Rockwell testers.',
      },
      {
        title: 'PVD Coating',
        description:
          'TiN, TiCN, CrN and DLC coatings applied in-house to ±2 µm uniformity. Coating adhesion tested per VDI 3198.',
      },
      {
        title: 'Re-sharpening & Re-grinding',
        description:
          'Return-and-resharpen service for our own blades. Original geometry preserved by reading the worn edge profile before grinding.',
      },
      {
        title: 'Quality Assurance',
        description:
          'CMM dimensional inspection, hardness mapping, surface roughness, and a full traceability chain per batch. PPAP / ISIR documentation on request.',
      },
    ]}
  />

  <Steps
    id="process"
    title="Eight Steps from RFQ to Delivery"
    tagline="Order Process"
    items={[
      {
        title: 'RFQ review',
        description:
          'You send a drawing, sample or written spec. We confirm material, geometry, tolerance, quantity and target price within one business day.',
      },
      {
        title: 'Engineering quotation',
        description:
          'Detailed quote with material grade, hardness, dimensional tolerance, lead time and tooling cost (if any). No hidden charges.',
      },
      {
        title: 'Drawing approval',
        description:
          'For custom parts, we issue a 2D / 3D drawing for your written approval before any steel is ordered.',
      },
      {
        title: 'Material procurement',
        description:
          'Steel sourced from audited mills with mill certificates. For common grades we hold buffer stock to compress lead time.',
      },
      {
        title: 'Rough machining',
        description:
          'Forging, milling and wire EDM to bring the blank close to net shape while preserving grain flow.',
      },
      {
        title: 'Heat treatment',
        description:
          'Vacuum hardening and tempering to specified HRC. Distortion minimised through controlled quench rates.',
      },
      {
        title: 'CNC grinding & coating',
        description:
          'Final geometry on 5-axis CNC grinders, optional PVD coating, then final QA inspection before packing.',
      },
      {
        title: 'Inspection & dispatch',
        description:
          'Dimensional report, hardness and surface records packaged with the goods. Export crating, FOB / CIF logistics arranged by our shipping team.',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Send Your Drawing',
        href: '/contact',
      },
      { text: 'Email Engineering', href: 'mailto:[email protected]' },
    ]}
  >
    <Fragment slot="title">
      No drawing? Send the broken blade.
    </Fragment>
    <Fragment slot="subtitle">
      For re-engineering work we can measure your worn blade and reproduce the original geometry — often improving on it
      based on what we see in the wear pattern.
    </Fragment>
  </CallToAction>
</Layout>