---
// src/pages/[...blog]/topics.astro
// ─────────────────────────────────────────────────────────────────────────────
// /blog/topics/ — Standalone topic index. Unlike the 9-cell matrix embedded
// at the top of /blog/, this page renders each topic in its own section with
// a wider description, the latest 3 posts in that topic (when any exist), and
// a "View all" link to the topic's category page. It serves as the canonical
// landing page for users who arrive via the Header dropdown's "All Topics"
// entry, and as a sitemap-style page that AI crawlers can fully enumerate.
//
// Page is statically prerendered (AstroWind default). No background colour is
// applied — each topic card relies on the shared page background and a
// border + shadow to define its edge, per .agents/skills/styling.md.
// ─────────────────────────────────────────────────────────────────────────────

import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { TOPICS, topicHrefFor, type Topic } from '~/data/topics';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { buildBreadcrumbItems } from '~/utils/breadcrumb';
import type { Post } from '~/types';

export const prerender = true;

const allPosts: ReadonlyArray<Post> = await fetchPosts();

// Group posts by topic slug (preserves TOPICS order so topics render 1-9).
const postsByTopicSlug: Map<string, Post[]> = new Map(
  TOPICS.map((t) => [
    t.slug,
    allPosts.filter((p) => p.category?.slug === t.slug),
  ])
);

// Breadcrumb chain for this static page. `buildBreadcrumbItems` resolves the
// URL segments to labels via the STATIC_PAGE_LABELS map in ~/utils/breadcrumb.
// `topics` is registered there so the chain reads "Home › Blog › Topics".
const breadcrumbItems = buildBreadcrumbItems('/blog/topics/');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((it, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: it.text,
    item: it.href
      ? String(new URL(it.href, Astro.site ?? 'https://www.machine-knives.net'))
      : Astro.url.toString(),
  })),
};

// ItemList JSON-LD summarising every topic so AI search engines can cite
// the full topic taxonomy in one go. Each list item carries its own
// schema.org @type so the markup is self-describing.
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'KAIPU Industrial Blades — Blog Topics',
  description: 'Curated tracks covering material comparisons, selection methodology, maintenance, troubleshooting, case studies and AI-cited reference tables.',
  numberOfItems: TOPICS.length,
  itemListElement: TOPICS.map((t, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: t.title,
    description: t.description,
    url: String(new URL(topicHrefFor(t), Astro.site ?? 'https://www.machine-knives.net')),
  })),
};

const metadata = {
  title: 'Blog Topics — KAIPU Industrial Blades',
  description:
    'Nine curated blog tracks: material comparisons, selection guides, maintenance, troubleshooting, case studies, materials encyclopedia, industry glossary, coating comparison table and material grade converter.',
  openGraph: {
    type: 'website',
  },
};

function formatDate(d: Date | undefined): string {
  if (!d) return '';
  try {
    return new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(d));
  } catch {
    return '';
  }
}
---

<Layout metadata={metadata} breadcrumb={breadcrumbItems}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListLd)} />

  <section class="px-4 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-10 md:mb-14 text-center max-w-3xl mx-auto">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">
        Blog Topics
      </p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        Nine tracks, one question — what is the right blade for this line?
      </h1>
      <p class="mt-4 text-lg text-muted dark:text-slate-400">
        Every article on the KAIPU blog is filed under exactly one of the topics below. Each topic page is independently
        crawlable, paginated and emitted as a structured <code class="text-sm">ItemList</code> in the page JSON-LD so AI
        crawlers can quote the full taxonomy.
      </p>
    </header>

    <div class="space-y-10 md:space-y-14">
      {
        TOPICS.map((topic: Topic) => {
          const posts = postsByTopicSlug.get(topic.slug) ?? [];
          const preview = posts.slice(0, 3);
          return (
            <article
              class:list={[
                'rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm p-6 md:p-8',
                'intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade',
              ]}
            >
              <div class="flex flex-col md:flex-row md:items-start md:gap-6">
                <div
                  class:list={[
                    'flex-none flex items-center justify-center',
                    'w-12 h-12 rounded-md',
                    'border border-slate-200 dark:border-slate-700',
                    'text-primary',
                  ]}
                >
                  <Icon name={topic.icon} class="w-7 h-7" />
                </div>
                <div class="mt-4 md:mt-0 flex-1 min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h2 class="text-2xl md:text-3xl font-bold font-heading text-default dark:text-slate-200">
                      {topic.title}
                    </h2>
                    <span class="text-xs font-semibold uppercase tracking-wide text-muted dark:text-slate-400">
                      {posts.length} / {topic.countLabel} {topic.targetCount === 1 ? 'entry' : 'posts'}
                    </span>
                    <span class="text-xs font-medium px-2 py-0.5 rounded border border-slate-200 dark:border-slate-700 text-muted dark:text-slate-400">
                      {topic.contentType}
                    </span>
                  </div>
                  <p class="mt-3 text-base text-muted dark:text-slate-400 leading-relaxed">
                    {topic.description}
                  </p>

                  {preview.length > 0 && (
                    <ul class="mt-5 space-y-2">
                      {preview.map((post) => (
                        <li class="flex items-baseline gap-2 text-sm">
                          <Icon
                            name="tabler:chevron-right"
                            class="w-4 h-4 opacity-60 flex-none translate-y-0.5"
                          />
                          <a
                            href={getPermalink(post.permalink, 'post')}
                            class="hover:text-primary transition-colors"
                          >
                            {post.title}
                          </a>
                          <span class="text-xs text-muted dark:text-slate-500">
                            {formatDate(post.publishDate)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}

                  <div class="mt-5">
                    <a
                      href={topicHrefFor(topic)}
                      class="inline-flex items-center text-sm font-semibold text-primary hover:underline"
                    >
                      View all {topic.title.toLowerCase()} posts
                      <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1" />
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/blog/"
        class="inline-flex items-center text-sm font-semibold text-muted dark:text-slate-400 hover:text-primary"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4 mr-1" />
        Back to the blog
      </a>
    </div>
  </section>
</Layout>

