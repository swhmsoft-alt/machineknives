---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'KAIPU Industrial Blades — Precision Machine Knives',
  description:
    'Manufacturer of industrial circular, straight, serrated, shear and granulator blades. D2, SKD11, M2 HSS, tungsten carbide. ISO 9001, in-house heat treatment and PVD coating.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="KAIPU Industrial Blades"
    title="Precision Engineered Machine Knives"
    subtitle="Industrial cutting tools for printing, packaging, paper, food, plastics recycling and metalworking lines. Manufactured in-house from D2, SKD11, M2 HSS and tungsten carbide."
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'Browse Products', href: '/products' },
    ]}
  />

  <Note />

  <Features
    id="categories"
    tagline="Product Range"
    title="Six Blade Families for Industrial Cutting"
    subtitle="Standard SKUs and custom builds, all manufactured under one roof. Click a category for details, or send us a drawing for a quote against your application."
    items={[
      { title: 'Circular Blades', description: 'Slitting knives for paper, film, foil and tape. OD 60–600 mm, ground to ≤ 0.01 mm parallel.', callToAction: { text: 'View Circular', href: '/products/category/circular', variant: 'link' } },
      { title: 'Straight Blades', description: 'Top blades for slitting, sheeting and converting lines. Length up to 3 m, single or double-bevel.', callToAction: { text: 'View Straight', href: '/products/category/straight', variant: 'link' } },
      { title: 'Serrated Blades', description: 'Toothed blades for tear-strips, perforations and cut-to-length. 6–32 TPI, custom tooth profiles.', callToAction: { text: 'View Serrated', href: '/products/category/serrated', variant: 'link' } },
      { title: 'Shear Blades', description: 'Industrial shear blades for guillotine, swing-beam and plate cutting up to 12 mm mild / 8 mm SS.', callToAction: { text: 'View Shear', href: '/products/category/shear', variant: 'link' } },
      { title: 'Granulator Knives', description: 'Rotor and stator knives for plastics granulators and shredders. M2 HSS, four-edge reversible.', callToAction: { text: 'View Granulator', href: '/products/category/granulator', variant: 'link' } },
      { title: 'Custom Blades', description: 'Reverse-engineered from your sample or drawing. Co-developed geometry, material and tolerance.', callToAction: { text: 'Discuss Custom', href: '/products/category/custom', variant: 'link' } },
    ]}
  />

  <Steps
    id="process"
    title="From Drawing to Dispatch"
    tagline="Manufacturing Process"
    items={[
      { title: 'RFQ review', description: 'Drawing or sample in, written spec out. Engineering responds within one business day.' },
      { title: 'Quotation', description: 'Material, hardness, tolerance, lead time and tooling cost — no hidden charges.' },
      { title: 'Drawing approval', description: 'For custom parts, 2D / 3D drawing sent for written sign-off before any steel is ordered.' },
      { title: 'Material procurement', description: 'Steel from audited mills with mill certificates. Buffer stock for common grades.' },
      { title: 'Heat treatment', description: 'Vacuum hardening and tempering to specified HRC. Hardness verified per batch.' },
      { title: 'CNC grinding', description: '5-axis CNC profile grinding, surface grinding to Ra 0.2 µm, EDM for carbide.' },
      { title: 'PVD coating', description: 'Optional TiN / TiCN / CrN / DLC coating applied in-house. ±2 µm uniformity.' },
      { title: 'Final QA & dispatch', description: 'CMM dimensional report, hardness and surface records shipped with the goods.' },
    ]}
  />

  <Stats
    title="By the numbers"
    stats={[
      { title: 'Years manufacturing', amount: '25+' },
      { title: 'Countries served', amount: '40+' },
      { title: 'Standard SKUs', amount: '600+' },
      { title: 'Annual capacity (parts)', amount: '120K' },
    ]}
  />

  <FAQs
    title="Frequently Asked Questions"
    items={[
      { title: 'What is the minimum order quantity?', description: 'For stocked SKUs we ship from 1 piece. For custom builds the MOQ is typically 10 pieces — below that the engineering and setup cost dominates the unit price.' },
      { title: 'What is the typical lead time?', description: 'Stocked sizes ship in 5–10 working days. Custom builds are 20–35 working days from drawing approval, depending on material, heat treatment and any PVD coating.' },
      { title: 'Do you offer re-sharpening service?', description: 'Yes. Send us the worn blade and we will measure the original geometry before grinding, so the re-sharpened part fits back into your line without re-tooling.' },
      { title: 'Can you match an existing OEM blade?', description: 'Yes. Send the part or a drawing and we will reverse-engineer the geometry and propose a material upgrade if the original blade is failing prematurely.' },
      { title: 'What materials can you work in?', description: 'D2, SKD11, DC53, M2 HSS, M4 HSS, H13, 6CrW2Si, tungsten carbide tipped, plus PVD coatings (TiN / TiCN / CrN / DLC). Mill certificates provided on request.' },
      { title: 'What is the typical payment terms?', description: '30% T/T deposit with order, 70% balance against B/L copy for new customers. Open-account terms available after one year of trading.' },
    ]}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'View Solutions', href: '/solutions' },
    ]}
  >
    <Fragment slot="title">Ready to put a real manufacturer on your RFQ list?</Fragment>
    <Fragment slot="subtitle">Send a drawing, a sample or a written specification. Engineering responds within one business day.</Fragment>
  </CallToAction>
</Layout>