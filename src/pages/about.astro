---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import PrecisionCta from '~/components/widgets/PrecisionCta.astro';

const metadata = {
  title: 'About Custom Machine Knives',
  description:
    'Company profile. ISO 9001:2015 certified manufacturer since 1998. 25+ years, 40+ countries served, 600+ standard SKUs, 120K parts annual capacity.',
  ignoreTitleTemplate: true,
};

const heroImage = { src: "/images/about/manufacturing-facility-overview.webp", alt: "Custom Machine Knives manufacturing facility overview" };
---

<Layout metadata={metadata}>
  <Hero
    tagline="About Custom Machine Knives"
    title="About Custom Machine Knives"
    subtitle="A focused manufacturer of industrial machine knives, exporting to converters, recyclers and OEMs across four continents. Privately held, ISO 9001 certified, and engineering-led."
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:mail' },
      { text: 'View Products', href: '/products' },
    ]}
    image={heroImage}
  />

  <Stats
    title="By the numbers"
    stats={[
      { title: 'Years manufacturing', amount: '25+' },
      { title: 'Countries served', amount: '40+' },
      { title: 'Standard SKUs', amount: '600+' },
      { title: 'Annual capacity (parts)', amount: '120K' },
    ]}
  />

  <Features
    id="values"
    tagline="Our Principles"
    title="Four Things We Refuse to Compromise On"
    items={[
      {
        title: 'Material Integrity',
        description:
          'Every batch of steel arrives with a mill certificate. We never blend grades and never substitute without written approval.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Dimensional Discipline',
        description:
          'CMM inspection on every dimension you specify, not just the ones that fit the schedule. Reports shipped with the parts.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'Honest Lead Times',
        description:
          'We quote what we can actually deliver. If a delay is unavoidable, you hear about it the day we know —not the day before shipment.',
        icon: 'tabler:clock',
      },
      {
        title: 'Long-Term Engineering',
        description:
          'Most of our customers have been buying from us for over a decade. We invest in relationships, not transactions.',
        icon: 'tabler:users',
      },
    ]}
  />

  <Content
    id="manufacturing"
    isReversed
    tagline="Manufacturing"
    title="What is Behind the Quote"
    subtitle="A short tour of what lives inside our plant, and why each step matters for your blade."
    items={[
      {
        title: 'Design office',
        description:
          'SolidWorks, AutoCAD and Mastercam. Engineers fluent in CAD-to-CAM, including direct import of customer STEP / IGES files.',
      },
      {
        title: 'Tool-room',
        description:
          'CNC milling, turning and wire EDM. Fixtures built in-house to hold tight tolerances without grinding vibration.',
      },
      {
        title: 'Heat treatment',
        description:
          'Two vacuum furnaces (12 and 30 bar quench) plus a cryogenic treatment cell. Hardness calibrated daily against a certified test block.',
      },
      {
        title: 'Grinding hall',
        description:
          'Five-axis CNC profile grinders, surface grinders and cylindrical grinders. Coolant filtration keeps thermal growth under control.',
      },
      {
        title: 'PVD coating',
        description:
          'Two PVD chambers (TiN / TiCN / CrN / DLC). Coating thickness measured on a Calotest rig and recorded in the batch file.',
      },
      {
        title: 'Quality lab',
        description:
          'CMM, optical comparator, surface roughness tester, micro-hardness tester. Reports archived for ten years per ISO 9001.',
      },
    ]}
  />

  <!-- Precision-engineering CTA closer -->
  <PrecisionCta
    id="about-cta"
    eyebrow="RFQ Partner"
    title={`<span class="block text-white">Ready to put a real manufacturer</span><span class="mt-1 block bg-clip-text text-transparent" style="background-image: linear-gradient(90deg, #fb923c 0%, #f59e0b 50%, #fbbf24 100%);">on your RFQ list?</span>`}
    subtitle="Send us a drawing or a worn sample. You will get a quote, a lead time and a direct line to the engineer who will follow the order through to dispatch."
    primaryAction={{ text: 'Request a Quote', href: '/contact' }}
    secondaryAction={{ text: 'Manufacturing Services', href: '/services', isMailto: false }}
    trustItems={[
      'Direct line to engineering',
      'Written quote within 1 business day',
      'ISO 9001:2015 since 2001',
    ]}
    cardEyebrow="Job #RFQ-2026"
    cardCaption="drawing or sample → quote → lead time → dispatch"
  />
</Layout>