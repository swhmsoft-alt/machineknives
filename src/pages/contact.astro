---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Contact from '~/components/widgets/Contact.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Contact Custom Machine Knives',
  description:
    'Send your blade specification, drawing or worn sample. Engineering responds with material grade, hardness, tolerance and lead time within one business day.',
};

const heroImage = { src: "/images/contact/engineering-team-drawing.webp", alt: "Custom Machine Knives engineering team reviewing a customer drawing" };
---

<Layout metadata={metadata}>
  <Hero
    tagline="Contact"
    title="Request a Quote for Custom Machine Knives"
    subtitle="Send a drawing, a worn sample, or a written specification. Our engineering team responds within one business day with material, hardness, tolerance and lead time."
    actions={[
      { text: 'View Products', href: '/products' },
    ]}
    image={heroImage}
  />

  <Contact
    id="rfq"
    title="Tell us about your cutting application"
    subtitle="Required fields are marked. We never share your details with third parties."
    inputs={[
      {
        type: 'text',
        name: 'fullName',
        label: 'Full Name',
        placeholder: 'Jane Smith',
        autocomplete: 'name',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company',
        placeholder: 'Acme Converting Co.',
        autocomplete: 'organization',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: '[email protected]',
        autocomplete: 'email',
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Phone (optional)',
        placeholder: '+1 555 123 4567',
        autocomplete: 'tel',
      },
      {
        type: 'text',
        name: 'productType',
        label: 'Product Type',
        placeholder: 'Circular / Straight / Serrated / Shear / Granulator / Custom',
      },
      {
        type: 'text',
        name: 'quantity',
        label: 'Quantity (optional)',
        placeholder: 'e.g. 50 pcs / quarter',
      },
      {
        type: 'text',
        name: 'materialSpec',
        label: 'Material / Specification (optional)',
        placeholder: 'e.g. D2, HRC 60, 250 × 80 × 5 mm',
      },
    ]}
    textarea={{
      label: 'Requirements',
      name: 'requirements',
      rows: 6,
      placeholder:
        'What are you cutting? What is the current blade failing on? Any geometry, hardness, tolerance or delivery deadline we should know about.',
    }}
    button="Send Quote Request"
    disclaimer={{
      label:
        'I agree to be contacted by Custom Machine Knives regarding this enquiry. My details will not be shared with third parties.',
    }}
    description="Engineering typically responds within one business day (Mon–Fri, GMT+8)."
  />

  <div class="max-w-xl mx-auto mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
    <p>
      Need to send attachments (drawings, sample photos, etc.)? Email them directly to&nbsp;<a
        class="font-medium text-primary hover:underline break-all"
        href="mailto:leo@custommachineknives.com"
        >leo@custommachineknives.com</a
      >.
    </p>
  </div>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Browse Product Catalog', href: '/products', icon: 'tabler:book' },
      { text: 'View Manufacturing Services', href: '/services' },
    ]}
  >
    <Fragment slot="title">
      Looking for technical reference first?
    </Fragment>
    <Fragment slot="subtitle">
      Our product catalog lists standard SKUs by category. If your part is custom, send us a drawing and we will quote
      against the spec rather than against a SKU.
    </Fragment>
  </CallToAction>
</Layout>