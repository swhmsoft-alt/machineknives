---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Products',
  description:
    'Circular, straight, serrated, shear and granulator blades, plus custom reverse-engineered industrial knives. D2, SKD11, M2 HSS, tungsten carbide.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Product Catalog"
    title="Industrial Blades by Category"
    subtitle="Six core product families covering the most common industrial cutting applications. All items are manufactured in-house and available with custom geometry, material and tolerance."
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'View Services', href: '/services' },
    ]}
  />

  <Features
    id="categories"
    tagline="Categories"
    title="Six Blade Families"
    subtitle="Click into a category to see standard SKUs, or send us a drawing for a custom build."
    items={[
      {
        title: 'Circular Blades',
        description:
          'Slitting and cutting circular knives for paper, film, foil and tape. OD range 60–600 mm.',
        callToAction: { text: 'View Circular', href: '/products/category/circular', variant: 'link' },
      },
      {
        title: 'Straight Blades',
        description:
          'Top blades for slitting, sheeting and converting lines. Length range 100–3000 mm.',
        callToAction: { text: 'View Straight', href: '/products/category/straight', variant: 'link' },
      },
      {
        title: 'Serrated Blades',
        description:
          'Toothed blades for tear-strips, perforations and cut-to-length on film, foil and paper.',
        callToAction: { text: 'View Serrated', href: '/products/category/serrated', variant: 'link' },
      },
      {
        title: 'Shear Blades',
        description:
          'Industrial shear blades for guillotine, swing-beam and scrap shear cutting of metal plate.',
        callToAction: { text: 'View Shear', href: '/products/category/shear', variant: 'link' },
      },
      {
        title: 'Granulator Knives',
        description:
          'Rotor / stator knives for plastics granulators and shredders in recycling and compounding.',
        callToAction: { text: 'View Granulator', href: '/products/category/granulator', variant: 'link' },
      },
      {
        title: 'Custom Blades',
        description:
          'Reverse-engineered from your sample or drawing. We co-design the geometry, material and tolerance.',
        callToAction: { text: 'Discuss Custom', href: '/products/category/custom', variant: 'link' },
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Send a Drawing',
        href: '/contact',
      },
      { text: 'View Solutions', href: '/solutions' },
    ]}
  >
    <Fragment slot="title">
      Don't see your part in the catalog?
    </Fragment>
    <Fragment slot="subtitle">
      Most of our work is custom. Send a drawing, a worn sample, or a written specification and our engineering team
      will quote against your application rather than against a SKU.
    </Fragment>
  </CallToAction>
</Layout>