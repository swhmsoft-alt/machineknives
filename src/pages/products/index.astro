---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { getCollection } from 'astro:content';

import { buildCategoryHref, getCategoryMeta, getCategoriesWithProducts } from '~/utils/products';

const metadata = {
  title: 'Products',
  description:
    'Circular, straight, serrated, shear and granulator blades, plus custom reverse-engineered industrial knives. D2, SKD11, M2 HSS, tungsten carbide.',
};

const products = await getCollection('product');
const categoriesWithProducts = getCategoriesWithProducts(products);

const categoryItems = [...categoriesWithProducts]
  .map((slug) => {
    const meta = getCategoryMeta(slug);
    return {
      slug,
      title: meta.title,
      description:
        meta.description ||
        `Browse ${meta.title.toLowerCase()} manufactured in-house with custom geometry, material and tolerance.`,
      href: buildCategoryHref(slug),
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const familyCount = categoryItems.length;
const familyWord = familyCount === 1 ? 'Family' : 'Families';
const subtitle = familyCount > 0
  ? 'Click into a category to see standard SKUs, or send us a drawing for a custom build.'
  : 'No product categories have been published yet. Send us a drawing or a worn sample for a custom quote.';
---

<Layout metadata={metadata}>
  <Hero
    tagline="Product Catalog"
    title="Industrial Blades by Category"
    subtitle={`${familyCount} product ${familyWord.toLowerCase()} covering the most common industrial cutting applications. All items are manufactured in-house and available with custom geometry, material and tolerance.`}
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'View Services', href: '/services' },
    ]}
  />

  {categoryItems.length > 0 && (
    <Features
      id="categories"
      tagline="Categories"
      title={`${familyCount} Blade ${familyWord}`}
      subtitle={subtitle}
      items={categoryItems.map((cat) => ({
        title: cat.title,
        description: cat.description,
        callToAction: {
          text: `View ${cat.title.replace(/ Blades$| Knives$/, '')}`,
          href: cat.href,
          variant: 'link',
        },
      }))}
    />
  )}

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Send a Drawing',
        href: '/contact',
      },
      { text: 'View Solutions', href: '/solutions' },
    ]}
  >
    <Fragment slot="title">
      Don't see your part in the catalog?
    </Fragment>
    <Fragment slot="subtitle">
      Most of our work is custom. Send a drawing, a worn sample, or a written specification and our engineering team
      will quote against your application rather than against a SKU.
    </Fragment>
  </CallToAction>
</Layout>