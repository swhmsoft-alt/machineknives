---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import {
  buildCategoryHref,
  buildProductHrefFromEntry,
  getCategoryMeta,
  humanizeSlugSegment,
  type Level1Category,
} from '~/utils/products';

// Per-category hero images. Filenames follow each category's human-friendly
// title in kebab-case (e.g. 'Granulator Knives' -> 'granulator-knives.jpg').
// Uploaded 2026-09-22; one image per level-1 category.
const CATEGORY_HERO_IMAGES: Record<Level1Category, string> = {
  circular: '/images/products/circular-blades.jpg',
  straight: '/images/products/straight-blades.jpg',
  serrated: '/images/products/serrated-blades.jpg',
  shear: '/images/products/shear-blades.jpg',
  granulator: '/images/products/granulator-knives.jpg',
  custom: '/images/products/custom-blades.jpg',
};
import {
  buildProductCategoryBreadcrumb,
  buildProductDetailBreadcrumb,
  type BreadcrumbItem,
} from '~/utils/breadcrumb';

import {
  generatePageSchema,
  buildProductDetail,
  buildBreadcrumb,
  buildFaqPage,
} from '~/lib/schema';
import { getProductFaqs } from '~/data/_product-faqs';

export const prerender = true;

interface CategoryPathProps {
  kind: 'category';
  level1: Level1Category;
  subcategories: string[];
}

interface ProductPathProps {
  kind: 'product';
  product: CollectionEntry<'product'>;
  subcategories: string[];
}

type PathProps = CategoryPathProps | ProductPathProps;

export async function getStaticPaths() {
  const products = await getCollection('product');

  const seenCategoryPaths = new Set<string>();
  const paths: Array<{ params: { slug: string }; props: PathProps }> = [];

  const slugForCategory = (level1: Level1Category, subs: readonly string[]) =>
    [level1, ...subs].join('/');

  // 1. Level-1 category pages — derived from products. A category is only
  //    exposed when at least one non-draft product exists for it.
  const level1Set = new Set<Level1Category>();
  for (const product of products) {
    if (product.data.draft) continue;
    level1Set.add(product.data.category as Level1Category);
  }
  for (const level1 of level1Set) {
    const slug = slugForCategory(level1, []);
    if (seenCategoryPaths.has(slug)) continue;
    seenCategoryPaths.add(slug);
    paths.push({
      params: { slug },
      props: { kind: 'category', level1, subcategories: [] },
    });
  }

  // 2. Subcategory pages (level 2 / 3) and product pages — derived from products.
  for (const product of products) {
    const subs = product.data.subcategories ?? [];
    const productLevel1 = product.data.category as Level1Category;

    // Subcategory landing pages at every depth the product occupies.
    for (let depth = 1; depth <= subs.length; depth++) {
      const subPath = subs.slice(0, depth);
      const slug = slugForCategory(productLevel1, subPath);
      if (seenCategoryPaths.has(slug)) continue;
      seenCategoryPaths.add(slug);
      paths.push({
        params: { slug },
        props: {
          kind: 'category',
          level1: productLevel1,
          subcategories: subPath,
        },
      });
    }

    // Product detail page.
    paths.push({
      params: { slug: slugForCategory(productLevel1, [...subs, product.id]) },
      props: { kind: 'product', product, subcategories: subs },
    });
  }

  return paths;
}

let categoryHeroImageHtml = '';

const props = Astro.props as PathProps;

// Aggregated state for either view. Declared up-front so the template can
// reference them without `var` hoisting tricks.
let productContent: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let productEntry: CollectionEntry<'product'> | null = null;
let productSubcategories: string[] = [];

let categoryLevel1: Level1Category | null = null;
let categorySubs: string[] = [];
let categoryDirectProducts: CollectionEntry<'product'>[] = [];
let categorySubcategoryChildren: Array<{ slug: string; count: number }> = [];
let categoryPageTitle = '';
let categoryPageSubtitle = '';
let categoryPageTagline = '';
let categoryPageIcon = '';
let categoryBreadcrumb: BreadcrumbItem[] = [];
let productBreadcrumb: BreadcrumbItem[] = [];

if (props.kind === 'product') {
  const rendered = await render(props.product);
  productContent = rendered.Content;
  productEntry = props.product;
  productSubcategories = props.subcategories;
  productBreadcrumb = buildProductDetailBreadcrumb(
    productEntry.data.category as Level1Category,
    productSubcategories,
    productEntry.data.title,
  );
} else {
  const allProducts = await getCollection('product');
  const l1: Level1Category = props.level1;
  const subs: string[] = props.subcategories;
  const isLevel1 = subs.length === 0;
  const meta = getCategoryMeta(l1);

  categoryLevel1 = l1;
  categorySubs = subs;

  categoryDirectProducts = allProducts
    .filter(
      (p) =>
        p.data.category === l1 &&
        (p.data.subcategories ?? []).length === subs.length &&
        (p.data.subcategories ?? []).every((s, i) => s === subs[i])
    )
    .sort((a, b) => a.data.title.localeCompare(b.data.title));

  // Collect immediate child subcategory names at the next depth.
  const buckets = new Map<string, number>();
  const depth = isLevel1 ? 0 : subs.length;
  for (const p of allProducts) {
    if (p.data.category !== l1) continue;
    const pSubs = p.data.subcategories ?? [];
    if (pSubs.length <= depth) continue;
    if (!isLevel1 && !pSubs.slice(0, depth).every((s, i) => s === subs[i])) continue;
    const childSlug = pSubs[depth];
    buckets.set(childSlug, (buckets.get(childSlug) ?? 0) + 1);
  }
  categorySubcategoryChildren = [...buckets.entries()]
    .map(([slug, count]) => ({ slug, count }))
    .sort((a, b) => a.slug.localeCompare(b.slug));

  if (isLevel1) {
    categoryPageTitle = meta.title;
    categoryPageSubtitle = meta.description;
    categoryPageTagline = meta.title;
    categoryPageIcon = meta.icon;
  } else {
    const leaf = subs[subs.length - 1];
    categoryPageTitle = humanizeSlugSegment(leaf);
    categoryPageSubtitle = `Browse ${categoryPageTitle.toLowerCase()} in ${meta.title}.`;
    categoryPageTagline = meta.title;
    categoryPageIcon = meta.icon;
  }

  categoryHeroImageHtml = `<img src="${CATEGORY_HERO_IMAGES[l1]}" alt="${meta.title} — industrial cutting tools" class="mx-auto rounded-md w-full" width="1024" height="576" loading="eager" />`;

  categoryBreadcrumb = buildProductCategoryBreadcrumb(l1, subs);
}

// ─── Schema.org JSON-LD for product detail pages ─────────────────────────
// Generated only when we are rendering a product entry; category pages keep
// their existing layout untouched. All schema entities pass through
// generatePageSchema() which enforces the /products/ route whitelist.
const SITE_URL = 'https://www.machine-knives.net';

let productSchemaJson = '';

if (productEntry) {
  const entry = productEntry;
  const productUrl = `${SITE_URL}${buildProductHrefFromEntry(entry)}`;

  const graph = generatePageSchema(
    'product-detail',
    `/products/${entry.id}/`,
    () => {
      const entities = [
        buildProductDetail({
          name: entry.data.title,
          description: entry.data.excerpt ?? undefined,
        }),
        // Mirror the visible breadcrumb chain so AI crawlers see the same
        // label set the user sees. Subcategory segments are included when the
        // product sits below a /products/{l1}/{sub1}[/{sub2}] path.
        buildBreadcrumb(
          productBreadcrumb.map((it) => ({
            name: it.text,
            url: it.href ? `${SITE_URL}${it.href}` : productUrl,
          })),
        ),
      ];
      const faqs = getProductFaqs(entry.id);
      if (faqs.length > 0) {
        entities.push(buildFaqPage(faqs.map((f) => ({ q: f.q, a: f.a }))));
      }
      return entities;
    },
  );

  productSchemaJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
}
---

{props.kind === 'category' && categoryLevel1 ? (
  <Layout metadata={{ title: `${categoryPageTitle} — KAIPU`, description: categoryPageSubtitle }} breadcrumb={categoryBreadcrumb}>
  <Hero
    tagline={categoryPageTagline}
    title={`${categoryPageTitle} for Industrial Cutting`}
    subtitle={categoryPageSubtitle}
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'All Categories', href: '/products' },
    ]}
    image={categoryHeroImageHtml}
  />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16">
    {categorySubcategoryChildren.length > 0 && categoryLevel1 && (
      <div class="mb-10">
        <div class="mb-4 flex items-center gap-3 text-secondary dark:text-blue-200 font-bold uppercase tracking-wide text-sm">
          <Icon name={categoryPageIcon} class="w-5 h-5" />
          <span>Subcategories</span>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {categorySubcategoryChildren.map((sub) => {
            const childSubs = [...categorySubs, sub.slug];
            return (
              <a
                href={buildCategoryHref(categoryLevel1, childSubs)}
                class="group flex items-center justify-between gap-3 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
              >
                <div>
                  <h3 class="text-base font-bold dark:text-white group-hover:text-primary transition-colors">{humanizeSlugSegment(sub.slug)}</h3>
                  <p class="text-xs text-muted dark:text-slate-400 mt-1">{sub.count} SKU{sub.count === 1 ? '' : 's'}</p>
                </div>
                <Icon name="tabler:arrow-right" class="w-5 h-5 text-primary" />
              </a>
            );
          })}
        </div>
      </div>
    )}

    <div class="mb-6 flex items-center gap-3 text-secondary dark:text-blue-200 font-bold uppercase tracking-wide text-sm">
      <Icon name={categoryPageIcon} class="w-5 h-5" />
      <span>Standard SKUs in this category</span>
    </div>

    {categoryDirectProducts.length === 0 ? (
      <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-8 text-center">
        <Icon name="tabler:package-off" class="mx-auto w-12 h-12 text-muted dark:text-slate-500 mb-4" />
        <h3 class="text-xl font-bold mb-2 dark:text-white">
          {categorySubcategoryChildren.length > 0 ? 'No direct SKUs in this branch' : 'No published SKUs in this category yet'}
        </h3>
        <p class="text-muted dark:text-slate-400 mb-4">
          {categorySubcategoryChildren.length > 0
            ? 'Browse the subcategories above, or send us a drawing for a custom build.'
            : 'We are in the process of publishing standard SKUs. Send us a drawing or a worn sample and we will quote against your application directly.'}
        </p>
        <a href="/contact" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium rounded-md bg-primary text-white hover:bg-secondary">Request a Quote</a>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {categoryDirectProducts.map((p) => (
          <a href={buildProductHrefFromEntry(p)} class="group block rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-6 hover:border-primary dark:hover:border-primary transition-colors">
            <h3 class="text-lg font-bold mb-2 dark:text-white group-hover:text-primary transition-colors">{p.data.title}</h3>
            <p class="text-sm text-muted dark:text-slate-400 mb-4">{p.data.excerpt}</p>
            <dl class="grid grid-cols-2 gap-2 text-xs">
              {p.data.bladeMaterial && (<div><dt class="text-muted dark:text-slate-500 uppercase tracking-wide">Material</dt><dd class="font-medium dark:text-slate-300">{p.data.bladeMaterial}</dd></div>)}
              {p.data.hardness && (<div><dt class="text-muted dark:text-slate-500 uppercase tracking-wide">Hardness</dt><dd class="font-medium dark:text-slate-300">{p.data.hardness}</dd></div>)}
            </dl>
            <span class="mt-4 inline-flex items-center text-sm text-primary group-hover:underline">View specifications<Icon name="tabler:arrow-right" class="ml-1 w-4 h-4" /></span>
          </a>
        ))}
      </div>
    )}
  </section>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
      { text: 'View All Categories', href: '/products' },
    ]}
  >
    <Fragment slot="title">Don't see the size or grade you need?</Fragment>
    <Fragment slot="subtitle">Every product on this page is also available in custom geometry, hardness and tolerance. Send a drawing or sample and we will quote against your application.</Fragment>
  </CallToAction>
  </Layout>
) : props.kind === 'product' && productEntry && productContent ? (
  <Layout metadata={{ title: `${productEntry.data.title} — KAIPU`, description: productEntry.data.excerpt ?? '' }} breadcrumb={productBreadcrumb}>
    <Hero
      tagline={getCategoryMeta(productEntry.data.category).label}
      title={productEntry.data.title}
      subtitle={productEntry.data.excerpt ?? ''}
      actions={[
        { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
        { text: 'Back to Catalog', href: buildCategoryHref(productEntry.data.category) },
      ]}
    />

    <!-- ========== UPPER: Product overview (image + spec card + CTA) ========== -->
    <section class='mx-auto max-w-7xl px-4 sm:px-6 py-8 md:py-12'>
      <div class='grid lg:grid-cols-2 gap-8 lg:gap-12 items-start'>
        <!-- LEFT: Large product image with zoom hint -->
        <div>
          <div class='aspect-square overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700 bg-page group relative'>
            {productEntry.data.image ? (
              <img
                src={productEntry.data.image}
                alt={productEntry.data.title}
                class='w-full h-full object-cover transition-transform duration-300 group-hover:scale-110'
                loading='eager'
                decoding='async'
              />
            ) : (
              <div class='w-full h-full flex flex-col items-center justify-center text-muted dark:text-slate-500'>
                <Icon name='tabler:photo-off' class='w-16 h-16 mb-2' />
                <span class='text-sm'>Product image — contact engineering</span>
              </div>
            )}
            {productEntry.data.image && (
              <div class='absolute bottom-3 right-3 inline-flex items-center gap-1 px-2 py-1 rounded-md bg-slate-900/70 text-white text-xs backdrop-blur'>
                <Icon name='tabler:zoom-in' class='w-3.5 h-3.5' /> Hover to zoom
              </div>
            )}
          </div>
          <p class='mt-3 text-xs text-muted dark:text-slate-400 text-center'>
            Typical application photo. Final geometry, finish and marking are confirmed in the engineering quotation.
          </p>
        </div>

        <!-- RIGHT: Quick specs card + CTAs -->
        <div>
          <p class='text-sm font-semibold uppercase tracking-widest text-primary mb-2'>
            {getCategoryMeta(productEntry.data.category).label} — {productEntry.data.category}
          </p>
          <h1 class='text-3xl md:text-4xl font-bold font-heading dark:text-white mb-3'>
            {productEntry.data.title}
          </h1>
          <p class='text-base text-muted dark:text-slate-300 mb-6'>
            {productEntry.data.excerpt ?? 'Precision industrial blade — engineering-grade material and tolerances.'}
          </p>

          <dl class='grid grid-cols-2 gap-x-6 gap-y-4 mb-6 p-5 rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm'>
            <div>
              <dt class='text-xs uppercase tracking-wide text-muted dark:text-slate-500'>Material</dt>
              <dd class='mt-1 text-sm font-medium dark:text-slate-200'>{productEntry.data.bladeMaterial ?? 'Specified per drawing'}</dd>
            </div>
            <div>
              <dt class='text-xs uppercase tracking-wide text-muted dark:text-slate-500'>Hardness</dt>
              <dd class='mt-1 text-sm font-medium dark:text-slate-200'>{productEntry.data.hardness ?? 'Per spec'}</dd>
            </div>
            <div>
              <dt class='text-xs uppercase tracking-wide text-muted dark:text-slate-500'>Coating</dt>
              <dd class='mt-1 text-sm font-medium dark:text-slate-200'>{productEntry.data.coating ?? 'As specified per drawing'}</dd>
            </div>
            <div>
              <dt class='text-xs uppercase tracking-wide text-muted dark:text-slate-500'>Category</dt>
              <dd class='mt-1 text-sm font-medium dark:text-slate-200'>{getCategoryMeta(productEntry.data.category).title}</dd>
            </div>
            {productSubcategories.length > 0 && (
              <div class='col-span-2'>
                <dt class='text-xs uppercase tracking-wide text-muted dark:text-slate-500'>Subcategory</dt>
                <dd class='mt-1 text-sm font-medium dark:text-slate-200'>{productSubcategories.map(humanizeSlugSegment).join(' > ')}</dd>
              </div>
            )}
          </dl>

          {productEntry.data.applications && productEntry.data.applications.length > 0 && (
            <div class='mb-6'>
              <p class='text-xs uppercase tracking-wide text-muted dark:text-slate-500 mb-2'>Typical applications</p>
              <div class='flex flex-wrap gap-2'>
                {productEntry.data.applications.map((app) => (
                  <span class='inline-flex items-center px-3 py-1 text-xs font-medium rounded-full bg-primary/10 text-primary dark:bg-blue-900/30 dark:text-blue-200'>
                    {app}
                  </span>
                ))}
              </div>
            </div>
          )}

          <div class='flex flex-wrap gap-3 mb-4'>
            <a
              href='/contact'
              class='inline-flex items-center justify-center px-6 py-3 text-base font-semibold rounded-md bg-primary text-white hover:bg-secondary shadow-sm transition-colors'
            >
              <Icon name='tabler:clipboard-text' class='w-5 h-5 mr-2' />
              Request a Quote
            </a>
            <a
              href='mailto:[email protected]'
              class='inline-flex items-center justify-center px-6 py-3 text-base font-medium rounded-md border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
            >
              <Icon name='tabler:mail' class='w-5 h-5 mr-2' />
              Email Engineering
            </a>
          </div>
          <a
            href={buildCategoryHref(productEntry.data.category, productSubcategories)}
            class='inline-flex items-center text-sm text-primary hover:underline'
          >
            <Icon name='tabler:arrow-left' class='w-4 h-4 mr-1' />
            More {getCategoryMeta(productEntry.data.category).label}s
          </a>

          <div class='mt-6 p-4 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50'>
            <div class='flex items-start gap-3'>
              <Icon name='tabler:info-circle' class='w-5 h-5 text-secondary dark:text-blue-200 mt-0.5 flex-shrink-0' />
              <p class='text-sm text-muted dark:text-slate-400'>
                The specifications on this page are typical for the product family. Final dimensions, tolerances, hardness and coating are confirmed in the engineering quotation. Contact us for a drawing or a quote against your application.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== LOWER: Tab section (Specifications / Applications / Description) ========== -->
    <section class='mx-auto max-w-7xl px-4 sm:px-6 pb-12 md:pb-16'>
      <div id='product-tabs' data-tabs class='not-prose'>
        <div role='tablist' aria-label='Product details' class='flex flex-wrap gap-x-2 gap-y-1 border-b border-slate-200 dark:border-slate-700 mb-6'>
          <button type='button' role='tab' id='tab-btn-specs' data-tab='specs' aria-controls='tab-panel-specs' aria-selected='true' class='tab-btn tab-active'>
            <Icon name='tabler:ruler-measure' class='w-4 h-4 mr-1.5' />
            Specifications
          </button>
          <button type='button' role='tab' id='tab-btn-apps' data-tab='apps' aria-controls='tab-panel-apps' aria-selected='false' class='tab-btn'>
            <Icon name='tabler:apps' class='w-4 h-4 mr-1.5' />
            Applications
          </button>
          <button type='button' role='tab' id='tab-btn-desc' data-tab='desc' aria-controls='tab-panel-desc' aria-selected='false' class='tab-btn'>
            <Icon name='tabler:file-text' class='w-4 h-4 mr-1.5' />
            Detailed Description
          </button>
        </div>

        <div role='tabpanel' id='tab-panel-specs' data-panel='specs' aria-labelledby='tab-btn-specs' class='tab-panel tab-panel-active'>
          <div id='specs-container' class='prose dark:prose-invert max-w-none'>
            <p class='text-muted'>Detailed specifications available on request.</p>
          </div>
        </div>

        <div role='tabpanel' id='tab-panel-apps' data-panel='apps' aria-labelledby='tab-btn-apps' class='tab-panel hidden'>
          <div class='grid gap-8 md:grid-cols-2'>
            <div>
              <h3 class='text-xl font-bold mb-4 dark:text-white'>Primary applications</h3>
              {productEntry.data.applications && productEntry.data.applications.length > 0 ? (
                <ul class='space-y-2'>
                  {productEntry.data.applications.map((app) => (
                    <li class='flex items-start gap-2'>
                      <Icon name='tabler:check' class='w-5 h-5 text-primary flex-shrink-0 mt-0.5' />
                      <span>{app}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class='text-muted'>Application engineering per customer drawing.</p>
              )}
            </div>
            <div>
              <h3 class='text-xl font-bold mb-4 dark:text-white'>Compatible machines</h3>
              <p class='text-muted mb-3'>
                Geometry and tolerances are configured per OEM specification. Compatible with major slitter, winder, sheeter and shear lines.
              </p>
              <ul class='grid grid-cols-2 gap-2 text-sm'>
                <li class='flex items-center gap-2'><Icon name='tabler:tool' class='w-4 h-4 text-primary' /> Slitter-rewinders</li>
                <li class='flex items-center gap-2'><Icon name='tabler:tool' class='w-4 h-4 text-primary' /> Cut-to-length</li>
                <li class='flex items-center gap-2'><Icon name='tabler:tool' class='w-4 h-4 text-primary' /> Guillotine shears</li>
                <li class='flex items-center gap-2'><Icon name='tabler:tool' class='w-4 h-4 text-primary' /> Swing-beam shears</li>
                <li class='flex items-center gap-2'><Icon name='tabler:tool' class='w-4 h-4 text-primary' /> Granulators</li>
                <li class='flex items-center gap-2'><Icon name='tabler:tool' class='w-4 h-4 text-primary' /> Shredders</li>
              </ul>
            </div>
          </div>
        </div>

        <div role='tabpanel' id='tab-panel-desc' data-panel='desc' aria-labelledby='tab-btn-desc' class='tab-panel hidden'>
          <div id='desc-container' class='prose dark:prose-invert max-w-none'>
            <productContent />
          </div>
        </div>
      </div>

      <style>
        .tab-btn {
          display: inline-flex;
          align-items: center;
          padding: 0.625rem 1rem;
          font-size: 0.875rem;
          font-weight: 500;
          color: rgb(100 116 139);
          border-bottom: 2px solid transparent;
          margin-bottom: -1px;
          background: transparent;
          cursor: pointer;
          transition: color 0.2s, border-color 0.2s;
        }
        .tab-btn:hover { color: rgb(15 23 42); }
        :global(.dark) .tab-btn { color: rgb(148 163 184); }
        :global(.dark) .tab-btn:hover { color: rgb(226 232 240); }
        .tab-btn.tab-active {
          color: var(--aw-color-primary, #2563eb);
          border-bottom-color: var(--aw-color-primary, #2563eb);
        }
        .tab-panel.hidden { display: none; }
        .tab-panel.tab-panel-active { display: block; }
      </style>

      <script>
        document.querySelectorAll('[data-tabs]').forEach((group) => {
          group.addEventListener('click', (e) => {
            const target = e.target;
            const btn = target && target.closest ? target.closest('[data-tab]') : null;
            if (!btn) return;
            const tab = btn.getAttribute('data-tab');
            group.querySelectorAll('[data-tab]').forEach((b) => {
              const active = b === btn;
              b.classList.toggle('tab-active', active);
              b.setAttribute('aria-selected', String(active));
            });
            group.querySelectorAll('[data-panel]').forEach((p) => {
              const active = p.getAttribute('data-panel') === tab;
              p.classList.toggle('hidden', !active);
              p.classList.toggle('tab-panel-active', active);
            });
          });
        });
        const desc = document.getElementById('desc-container');
        const specs = document.getElementById('specs-container');
        if (desc && specs && desc.querySelector('table')) {
          const heading = desc.querySelector('h2, h3');
          const table = desc.querySelector('table');
          if (table) {
            specs.innerHTML = '';
            if (heading) {
              const cloned = heading.cloneNode(true);
              cloned.classList.add('not-prose');
              specs.appendChild(cloned);
            }
            const wrap = document.createElement('div');
            wrap.className = 'not-prose overflow-x-auto';
            wrap.appendChild(table.cloneNode(true));
            specs.appendChild(wrap);
            const dup = desc.querySelector('table');
            if (dup) dup.style.display = 'none';
          }
        }
      </script>
    </section>

    <CallToAction
      actions={[
        { variant: 'primary', text: 'Request a Quote', href: '/contact', icon: 'tabler:clipboard-text' },
        { text: 'Email Engineering', href: 'mailto:[email protected]' },
      ]}
    >
      <Fragment slot='title'>Ready to order or need a custom version?</Fragment>
      <Fragment slot='subtitle'>Send your drawing, your worn blade, or a written spec. We will respond within one business day.</Fragment>
    </CallToAction>

    {productSchemaJson && (
      <script type='application/ld+json' set:html={productSchemaJson} />
    )}
  </Layout>
) : null}