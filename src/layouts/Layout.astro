---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';
import { buildBreadcrumbItems } from '~/utils/breadcrumb';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';
import { safeEmitSchema } from '~/lib/schema';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;

// ─── Global JSON-LD (Organization + WebSite + BreadcrumbList + Service on home) ──
// Each block is funnelled through `safeEmitSchema()`: empty objects / empty
// BreadcrumbLists never produce HTML. This is the core fix for the GSC
// "Missing field itemListElement" report — without it the homepage would emit
// a `<script type="application/ld+json">` containing an empty BreadcrumbList.
const siteUrl = String(Astro.site ?? 'https://custommachineknives.com').replace(/\/$/, '');
const breadcrumbLdItems = buildBreadcrumbItems(Astro.url.pathname).map((it, idx) => ({
  '@type': 'ListItem',
  position: idx + 1,
  name: it.text,
  item: it.href ? siteUrl + it.href : siteUrl + '/',
}));
const organizationLdJson = safeEmitSchema('Organization', {
  name: 'Custom Machine Knives',
  url: siteUrl + '/',
  logo: siteUrl + '/favicon.svg',
  description:
    'Manufacturer of industrial machine knives for printing, packaging, converting, food processing and recycling.',
  // B2B global-service properties (per the .clinerules decision log:
  // no fabricated telephone; only the contact email hard-coded in CTA buttons).
  email: '[email protected]',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: '[email protected]',
    areaServed: 'Worldwide',
    availableLanguage: ['English'],
  },
});
const websiteLdJson = safeEmitSchema('WebSite', {
  name: 'Custom Machine Knives',
  url: siteUrl + '/',
});
const breadcrumbLdJson =
  breadcrumbLdItems.length > 0
    ? safeEmitSchema('BreadcrumbList', { itemListElement: breadcrumbLdItems })
    : null;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const serviceLdJson = isHome
  ? safeEmitSchema('Service', {
      serviceType: 'Custom industrial blade manufacturing',
      provider: {
        '@type': 'Organization',
        name: 'Custom Machine Knives',
        url: siteUrl + '/',
      },
      areaServed: 'Worldwide',
      description:
        'Design, manufacture and re-sharpening of precision industrial machine knives: circular, straight, serrated, shear and granulator blades.',
    })
  : null;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />

    {/*
      Open Graph article freshness signals. These are not surfaced by
      astro-seo's <SEO /> because MetaData exposes them as the optional
      `dateModified` / `datePublished` props. Render them once at the
      layout level so any page can opt in via `metadata={...}` without
      touching individual templates.
    */}
    {metadata.dateModified && (
      <meta property="article:modified_time" content={metadata.dateModified} />
    )}
    {metadata.datePublished && (
      <meta property="article:published_time" content={metadata.datePublished} />
    )}

    {
      organizationLdJson && (
        <script type="application/ld+json" set:html={organizationLdJson} />
      )
    }
    {
      websiteLdJson && (
        <script type="application/ld+json" set:html={websiteLdJson} />
      )
    }
    {
      breadcrumbLdJson && (
        <script type="application/ld+json" set:html={breadcrumbLdJson} />
      )
    }
    {
      serviceLdJson && (
        <script type="application/ld+json" set:html={serviceLdJson} />
      )
    }

    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <Intersect />
  </body>
</html>
