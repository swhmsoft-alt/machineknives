---
import type { HTMLTag } from 'astro/types';
import type { Widget } from '~/types';
import { twMerge } from 'tailwind-merge';

export interface Props extends Widget {
  containerClass?: string;
  ['as']?: HTMLTag;
}

const { id, isDark = false, containerClass = '', bg, as = 'section' } = Astro.props;

const WrapperTag = as;
---

<WrapperTag class="relative not-prose scroll-mt-[72px]" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none -z-[1]" aria-hidden="true">
    <slot name="bg">
      {
        bg ? (
          <Fragment set:html={bg} />
        ) : (
          <div class:list={['absolute inset-0', { 'bg-dark dark:bg-transparent': isDark }]} />
        )
      }
    </slot>
  </div>
  <div
    class:list={[
      twMerge(
        'relative mx-auto max-w-7xl px-4 md:px-6 text-default intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade widget-section',
        containerClass
      ),
      { dark: isDark },
    ]}
  >
    <slot />
  </div>
</WrapperTag>

<style>
  /* Fluid section vertical padding: replaces the py-12 / md:py-16 /
   * lg:py-20 ladder so spacing scales smoothly across viewports
   * instead of stepping at md: and lg:. The range matches the
   * original ladder (48–80px); viewport midpoint (7vw) lands at
   * roughly 67px on a 960px screen, which sits naturally between
   * the old 64px and 80px values.
   */
  .widget-section {
    padding-block: clamp(3rem, 7vw, 5rem);
  }
</style>
