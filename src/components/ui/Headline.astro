---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  classes = {},
} = Astro.props;

const {
  container: containerClass = 'max-w-3xl',
  title: titleClass = 'text-3xl md:text-4xl ',
  subtitle: subtitleClass = 'text-xl',
} = classes;
---

{
  (title || subtitle || tagline) && (
    <div class={twMerge('mb-8 md:mx-auto md:mb-12 text-center', containerClass)}>
      {tagline && (
        <p class="text-sm font-semibold text-muted spec-eyebrow" set:html={tagline} />
      )}
      {title && (
        <h2
          class={twMerge('font-bold leading-tighter tracking-tighter font-heading text-heading text-3xl', titleClass)}
          set:html={title}
        />
      )}

      {subtitle && <p class={twMerge('mt-4 text-muted', subtitleClass)} set:html={subtitle} />}
    </div>
  )
}

<style>
  /* spec-eyebrow: small spec-font label that sits above the headline.
   * Replaces the prior tracked-out ALL-CAPS eyebrow that read as the
   * generic "AI default" template. No uppercase, no heavy tracking —
   * sentence-case label, sized to read as a content marker, not as
   * a typographic flourish. Tabular numerals for spec content. */
  .spec-eyebrow {
    font-feature-settings: 'tnum', 'ss01';
    letter-spacing: 0.01em;
  }
</style>
