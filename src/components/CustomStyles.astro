---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    /* EdgeTech Industrial — precision engineering palette */
    --aw-color-primary: rgb(15 76 129);        /* deep industrial blue */
    --aw-color-secondary: rgb(28 50 92);      /* steel navy */
    --aw-color-accent: rgb(217 119 38);       /* molten metal accent */

    --aw-color-text-heading: rgb(17 24 39);   /* slate-900 */
    --aw-color-text-default: rgb(31 41 55);   /* slate-800 */
    --aw-color-text-muted: rgb(31 41 55 / 70%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(10 15 28);

    ::selection {
      background-color: rgb(15 76 129);
      color: white;
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(56 132 210);      /* lighter blue for dark bg */
    --aw-color-secondary: rgb(96 165 250);    /* sky-400 */
    --aw-color-accent: rgb(251 146 60);       /* orange-400 */

    --aw-color-text-heading: rgb(243 244 246);
    --aw-color-text-default: rgb(229 231 235);
    --aw-color-text-muted: rgb(229 231 235 / 70%);
    --aw-color-bg-page: rgb(10 15 28);

    ::selection {
      background-color: rgb(56 132 210);
      color: rgb(10 15 28);
    }
  }
</style>
