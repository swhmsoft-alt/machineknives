---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  /* Font family is provided by Astro's native Fonts API (see `fonts` in
   * astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
   * To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
   *
   * Color / spacing / shadow tokens live in src/assets/styles/tokens.css
   * (imported by tailwind.css) — this file only wires up the fonts.
   */

  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);
  }

  /* =========================================================================
   * Engineering-grade table styling for prose containers.
   * Applied globally to any <table> inside `.prose` so all markdown-rendered
   * content on the site gets the same treatment with one rule set:
   *
   *   - /blog/<category>/<slug>/   (article body, SinglePost.astro)
   *   - /privacy/ /terms/          (MarkdownLayout.astro)
   *   - /products/<...>/           (products/[...slug].astro)
   *
   * Design intent: procurement managers and technical engineers need to scan
   * chemistry / hardness / spec tables quickly. Tabular numerals align the
   * digits; zebra rows separate parameter rows at a glance; uppercase muted
   * column headers mark the column meanings without competing with the data.
   *
   * No `position: sticky` on thead or first column: Safari + a Chromium
   * regression rendered the thead as a zero-height band or with columns
   * drifting out of alignment with the tbody. Tables are short (8-15 rows)
   * so sticky behaviour is not worth the rendering risk.
   *
   * Rounded corners are applied to the four corner cells rather than to the
   * table itself; `border-radius` on <table> does not clip inner cell
   * backgrounds reliably across browsers.
   * ========================================================================= */

  .prose table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 1.75em 0;
    border: 1px solid var(--aw-color-border);
    background: var(--aw-color-surface);
    table-layout: auto;
  }
  .dark .prose table {
    border-color: var(--aw-color-border);
    background: var(--aw-color-surface);
  }

  .prose table thead th {
    padding: 0.75rem 1rem;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--aw-color-text-muted);
    text-align: left;
    vertical-align: middle;
    background: var(--aw-color-surface-alt);
    border-bottom: 2px solid var(--aw-color-border-strong);
  }

  .prose table tbody tr {
    border-bottom: 1px solid var(--aw-color-border);
    transition: background-color 0.12s ease;
  }
  .prose table tbody tr:nth-child(even) {
    background: var(--aw-color-surface-alt);
  }
  .dark .prose table tbody tr:nth-child(even) {
    background: rgb(255 255 255 / 2%);
  }
  .prose table tbody tr:hover {
    background: rgb(15 76 129 / 5%);
  }
  .dark .prose table tbody tr:hover {
    background: rgb(56 132 210 / 10%);
  }
  .prose table tbody tr:last-child {
    border-bottom: none;
  }

  .prose table tbody td {
    padding: 0.65rem 1rem;
    vertical-align: top;
    border: none;
    font-variant-numeric: tabular-nums;
  }
  .prose table tbody td:first-child {
    font-weight: 600;
    color: var(--aw-color-text-default);
    white-space: nowrap;
  }
  .prose table tbody td:not(:first-child) {
    text-align: right;
    color: var(--aw-color-text-default);
  }

  .prose table thead tr:first-child th:first-child {
    border-top-left-radius: var(--aw-radius-md);
  }
  .prose table thead tr:first-child th:last-child {
    border-top-right-radius: var(--aw-radius-md);
  }
  .prose table tbody tr:last-child td:first-child {
    border-bottom-left-radius: var(--aw-radius-md);
  }
  .prose table tbody tr:last-child td:last-child {
    border-bottom-right-radius: var(--aw-radius-md);
  }

  /* Wide tables scroll horizontally within the prose wrapper instead of
   * overflowing the page. Safe for other prose children — paragraphs,
   * headings, lists, images all wrap inside their column. */
  .prose {
    overflow-x: auto;
  }
</style>
