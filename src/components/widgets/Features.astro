---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Features as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 2,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const columnsClass =
  columns === 4
    ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
    : columns === 3
      ? 'lg:grid-cols-3 sm:grid-cols-2'
      : columns === 2
        ? 'sm:grid-cols-2'
        : '';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl features-section ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  {
    items.length > 0 && (
      <div class:list={['grid mx-auto gap-6 md:gap-8', columnsClass]}>
        {items.map(({ title: itemTitle, description, icon, callToAction }) => (
          <div class="feature-card intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <div class="flex flex-row max-w-none">
              {(icon || defaultIcon) && (
                <div class="flex justify-center feature-icon-wrap">
                  <Icon
                    name={icon || defaultIcon}
                    class="feature-icon"
                  />
                </div>
              )}
              <div class="mt-0.5 flex-1">
                {itemTitle && <h3 class="text-xl md:text-[1.3rem] font-bold">{itemTitle}</h3>}
                {description && <p class:list={[{ 'mt-3': itemTitle }, 'text-muted']} set:html={description} />}
                {callToAction && (
                  <div class:list={[{ 'mt-3': itemTitle || description }]}>
                    <Button variant="link" {...callToAction} />
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    )
  }
</WidgetWrapper>

<style>
  /* === Features: card-elevated grid =====================================
   * Replaces the prior flat row with bordered cards that lift on hover.
   * Icon stays in its primary-color circular badge but the badge gets
   * a subtle shadow for depth.
   */
  .feature-card {
    padding: 1.5rem;
    border: 1px solid var(--aw-color-border);
    border-radius: var(--aw-radius-card);
    background-color: var(--aw-color-surface);
    box-shadow: var(--aw-shadow-card);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--aw-color-border-strong);
    box-shadow: var(--aw-shadow-card-hover);
  }

  .feature-icon-wrap {
    flex-shrink: 0;
    margin-right: 1rem;
  }
  .feature-icon {
    width: 3rem;
    height: 3rem;
    padding: 0.75rem;
    color: white;
    background-color: var(--aw-color-primary);
    border-radius: var(--aw-radius-pill);
    box-shadow: 0 6px 16px rgb(15 76 129 / 25%);
  }
</style>
</WidgetWrapper>
