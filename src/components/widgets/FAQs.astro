---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Faqs as Props } from '~/types';

const {
  title = '',
  subtitle = '',
  tagline = '',
  items = [],
  columns = 2,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const columnsClass =
  columns === 4
    ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
    : columns === 3
      ? 'lg:grid-cols-3 sm:grid-cols-2'
      : columns === 2
        ? 'sm:grid-cols-2'
        : 'max-w-4xl';

// Default light-gray FAQs background to visually separate from Features/Cases.
const defaultBg = '<div class="absolute inset-0 faqs-bg" aria-hidden="true"></div>';
const hasBgSlot = Astro.slots.has('bg');
const effectiveBg = hasBgSlot ? bg : defaultBg;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto faqs-section ${classes?.container ?? ''}`} bg={effectiveBg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  {
    items.length > 0 && (
      <div class:list={['grid mx-auto gap-y-8 md:gap-y-12 gap-8', columnsClass]}>
        {items.map(({ title: itemTitle, description, icon, callToAction }) => (
          <div class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <div class="flex flex-row max-w-none">
              <div class="flex justify-center">
                <Icon
                  name={icon || 'tabler:chevron-right'}
                  class="flex-shrink-0 mt-1 w-6 h-6 text-primary mr-2 rtl:mr-0 rtl:ml-2"
                />
              </div>
              <div class="mt-0.5">
                {itemTitle && <h3 class="text-xl font-bold">{itemTitle}</h3>}
                {description && <p class:list={[{ 'mt-3': itemTitle }, 'text-muted']} set:html={description} />}
                {callToAction && (
                  <div class:list={[{ 'mt-3': itemTitle || description }]}>
                    <Button variant="link" {...callToAction} />
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    )
  }
  {
    items.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: items.map(({ title: t, description }) => ({
            '@type': 'Question',
            name: t,
            acceptedAnswer: {
              '@type': 'Answer',
              text:
                typeof description === 'string'
                  ? description.replace(/<[^>]*>/g, '')
                  : '',
            },
          })),
        })}
      />
    )
  }
</WidgetWrapper>

<style>
  /* === FAQs: soft slate background to separate from Features/Cases ====
   * Light tint gives a visual breath between the orange Stats block
   * and the dark CTA closer, while keeping FAQ text dark for reading.
   */
  .faqs-bg {
    background-color: var(--aw-color-surface-alt);
  }
</style>
