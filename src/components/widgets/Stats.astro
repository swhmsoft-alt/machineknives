---
import type { Stats as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  stats = [],

  id,
  isDark = true,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Default orange-gradient Stats background — the brand's loudest section.
const defaultBg = '<div class="absolute inset-0 stats-bg" aria-hidden="true"></div>';
const hasBgSlot = Astro.slots.has('bg');
const effectiveBg = hasBgSlot ? bg : defaultBg;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto stats-section ${classes?.container ?? ''}`} bg={effectiveBg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="flex flex-wrap justify-center -m-4 text-center">
    {
      stats &&
        stats.map(({ amount, title, icon }) => (
          <div class="stats-item p-4 md:w-1/4 sm:w-1/2 w-full min-w-[220px] text-center intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
            {icon && (
              <div class="flex items-center justify-center mx-auto mb-4 text-white">
                <Icon name={icon} class="w-10 h-10" />
              </div>
            )}
            {amount && (
              <div class="stats-amount font-heading font-extrabold tracking-tight">
                {amount}
              </div>
            )}
            {title && (
              <div class="stats-label">
                {title}
              </div>
            )}
          </div>
        ))
    }
  </div>
</WidgetWrapper>

<style>
  /* === Stats: orange-gradient feature wall ===============================
   * Replaces the prior thin slate-bordered stat row with a bold orange
   * gradient section that announces itself visually on the page.
   */
  .stats-bg {
    background: var(--aw-gradient-stats);
  }

  .stats-section {
    color: var(--aw-color-text-on-accent);
  }

  .stats-amount {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
    color: var(--aw-color-text-on-accent);
  }

  .stats-label {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--aw-color-text-on-accent);
    opacity: 0.92;
  }

  .stats-item {
    border-right: 1px solid rgb(255 255 255 / 20%);
  }
  .stats-item:last-child {
    border-right: none;
  }
  @media (max-width: 767px) {
    .stats-item {
      border-right: none;
    }
  }
</style>
