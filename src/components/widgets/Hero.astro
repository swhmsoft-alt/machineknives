---
import Image from "~/components/common/Image.astro";
import Button from "~/components/ui/Button.astro";

import type { Hero as Props } from "~/types";

const {
  title = await Astro.slots.render("title"),
  subtitle = await Astro.slots.render("subtitle"),
  tagline,
  content = await Astro.slots.render("content"),
  actions = await Astro.slots.render("actions"),
  image = await Astro.slots.render("image"),
  // Optional engineering spec strip rendered below the main grid.
  // Each entry: { label, value } — e.g. HRC, Lead time, Tolerance.
  specs,
  id,
} = Astro.props;
---

<section class="relative not-prose hero-section" {...id ? { id } : {}}>
  <div class="relative max-w-7xl mx-auto px-4 md:px-6">
    <div class="hero-grid">
      {/* Left: text column */}
      <div class="hero-text">
        {tagline && <p class="hero-eyebrow" set:html={tagline} />}
        {title && <h1 class="hero-title" set:html={title} />}
        {subtitle && <p class="hero-subtitle" set:html={subtitle} />}
        {actions && (
          <div class="hero-actions">
            {Array.isArray(actions) ? (
              actions.map((action, i) => (
                <div class="hero-action-wrap">
                  <Button {...(action || {})} class={`${i === 0 ? 'hero-cta-primary' : 'hero-cta-ghost'}`} />
                </div>
              ))
            ) : (
              <Fragment set:html={actions} />
            )}
          </div>
        )}
        {content && <Fragment set:html={content} />}
      </div>

      {/* Right: image column */}
      {image && (
        <div class="hero-image">
          {typeof image === "string" ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="hero-img-el"
              widths={[400, 768, 1024]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="eager"
              fetchpriority="high"
              width={1024}
              height={576}
              format="webp"
              {...image}
            />
          )}
        </div>
      )}
    </div>

    {/* Optional spec strip — engineering blueprint detail row. */}
    {specs && specs.length > 0 && (
      <dl class="hero-spec-strip">
        {specs.map(({ label, value }) => (
          <div class="hero-spec-item">
            <dt class="hero-spec-label" set:html={label} />
            <dd class="hero-spec-value" set:html={value} />
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  /* === Hero: asymmetric blueprint layout ===
   * Phase 3 — replaces the dark radial-gradient centered hero with a
   * light, asymmetric layout: text on the left, product image on the
   * right, optional engineering spec strip below. */

  .hero-section {
    color: var(--aw-color-graphite);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .hero-text {
    max-width: 38rem;
    text-align: left;
  }

  .hero-image {
    display: flex;
    justify-content: center;
  }
  .hero-img-el {
    width: 100%;
    height: auto;
    border: 1px solid var(--aw-color-rule);
    border-radius: var(--aw-radius-sm);
    background-color: var(--aw-color-surface);
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--aw-color-accent);
    border-radius: var(--aw-radius-sm);
    background-color: transparent;
    color: var(--aw-color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    font-feature-settings: 'tnum';
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--aw-color-graphite);
    margin-bottom: 1.25rem;
    animation: hero-reveal 0.55s ease-out both;
  }

  .hero-subtitle {
    color: var(--aw-color-graphite-700);
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 36rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-action-wrap {
    display: flex;
  }

  .hero-cta-primary {
    background-color: var(--aw-color-accent) !important;
    border-color: var(--aw-color-accent) !important;
    color: var(--aw-color-text-on-accent) !important;
  }
  .hero-cta-primary:hover {
    background-color: var(--aw-color-accent-hover) !important;
    border-color: var(--aw-color-accent-hover) !important;
  }

  .hero-cta-ghost {
    background-color: transparent !important;
    border-color: var(--aw-color-graphite) !important;
    color: var(--aw-color-graphite) !important;
  }
  .hero-cta-ghost:hover {
    background-color: var(--aw-color-graphite) !important;
    color: var(--aw-color-paper) !important;
    border-color: var(--aw-color-graphite) !important;
  }

  .hero-spec-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    margin-bottom: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid var(--aw-color-rule);
    border-bottom: 1px solid var(--aw-color-rule);
  }
  .hero-spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1.25rem 0.75rem 0;
    border-right: 1px solid var(--aw-color-rule);
  }
  .hero-spec-item:last-child {
    border-right: none;
  }
  .hero-spec-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--aw-color-graphite-700);
    text-transform: uppercase;
    font-feature-settings: 'tnum';
    margin: 0;
  }
  .hero-spec-value {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--aw-color-graphite);
    font-feature-settings: 'tnum';
    margin: 0;
  }

  @keyframes hero-reveal {
    0% {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
