---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  actions = await Astro.slots.render('actions'),

  id,
  isDark = true,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Default deep-blue gradient CTA — the page's conversion closer.
const defaultBg = '<div class="absolute inset-0 cta-bg" aria-hidden="true"></div>';
const hasBgSlot = Astro.slots.has('bg');
const effectiveBg = hasBgSlot ? bg : defaultBg;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto cta-section ${classes?.container ?? ''}`} bg={effectiveBg}>
  <div
    class="max-w-3xl mx-auto text-center p-8 md:p-12 rounded-card"
  >
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0',
        title: 'cta-title text-4xl md:text-5xl font-bold tracking-tight mb-5 font-heading',
        subtitle: 'cta-subtitle text-lg md:text-xl',
      }}
    />
    {
      actions && (
        <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 mt-8">
          {Array.isArray(actions) ? (
            actions.map((action, i) => (
              <div class="flex w-full sm:w-auto">
                <Button
                  {...(action || {})}
                  class={`w-full sm:mb-0 ${i === 0 ? 'cta-btn-primary' : 'cta-btn-ghost'}`}
                />
              </div>
            ))
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>

<style>
  /* === CallToAction: deep-blue gradient closer ===========================
   * Drops the prior shadow-bordered card-in-section pattern in favor of
   * a flat full-bleed dark gradient with a single bright CTA.
   */
  .cta-bg {
    background: var(--aw-gradient-cta);
  }

  .cta-section {
    color: var(--aw-color-text-on-dark);
  }

  .cta-title {
    color: var(--aw-color-text-on-dark);
  }

  .cta-subtitle {
    color: var(--aw-color-text-on-dark-muted);
    line-height: 1.55;
  }

  .cta-btn-primary {
    background-color: var(--aw-color-accent) !important;
    border-color: var(--aw-color-accent) !important;
    color: var(--aw-color-text-on-accent) !important;
    box-shadow: var(--aw-shadow-cta);
    padding-inline: 2rem;
    font-weight: 700;
  }
  .cta-btn-primary:hover {
    background-color: var(--aw-color-accent-hover) !important;
    border-color: var(--aw-color-accent-hover) !important;
    transform: translateY(-2px);
  }

  .cta-btn-ghost {
    background-color: transparent !important;
    border-color: var(--aw-color-border-on-dark) !important;
    color: var(--aw-color-text-on-dark) !important;
  }
  .cta-btn-ghost:hover {
    background-color: rgb(255 255 255 / 10%) !important;
    border-color: rgb(255 255 255 / 30%) !important;
  }
</style>
