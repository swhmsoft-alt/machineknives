---
// src/components/blog/ToBlogLink.astro
// ─────────────────────────────────────────────────────────────────────────────
// Visual divider that sits between the article body and the Related Posts
// section on every /blog/<category>/<slug>/ page. Replaces the original small
// tertiary "Back to Blog" button (which read as a stranded element) with a
// centered hairline + icon + link composition, so the eye reads it as a true
// section break rather than a button afterthought.
import { Icon } from 'astro-icon/components';
import { getBlogPermalink } from '~/utils/permalinks';
---

<div class="mx-auto max-w-3xl px-6 py-10 md:py-14 text-center">
  <div class="inline-flex items-center gap-3 text-sm text-muted dark:text-slate-400">
    <span aria-hidden="true" class="h-px w-10 bg-slate-300 dark:bg-slate-700"></span>
    <Icon name="tabler:circle-dashed" class="w-5 h-5 text-primary" aria-hidden="true" />
    <a
      href={getBlogPermalink()}
      class="font-semibold text-primary hover:underline underline-offset-4 transition"
    >
      Back to all posts
    </a>
    <Icon name="tabler:circle-dashed" class="w-5 h-5 text-primary" aria-hidden="true" />
    <span aria-hidden="true" class="h-px w-10 bg-slate-300 dark:bg-slate-700"></span>
  </div>
</div>
