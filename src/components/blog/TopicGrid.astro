---
// src/components/blog/TopicGrid.astro
// ─────────────────────────────────────────────────────────────────────────────
// 9-cell topic grid used on /blog/ and /blog/topics/. Renders a tabler icon,
// title, description, post count and a "Browse" arrow for every topic defined
// in `src/data/topics.ts`.
//
// Design rules followed:
//   • No `bg-*` color utility — full-site background is unified via `bg-page`.
//     Cells rely on `border border-slate-200 dark:border-slate-700 + shadow`
//     to define their boundary on the shared page background (per
//     .agents/skills/styling.md § "Background Color Discipline").
//   • No section-level background class — the parent section inherits the
//     body background.
//   • The optional `postsByTopic` map lets the caller overlay live post
//     counts (computed at build time) on top of the static `countLabel`,
//     so the cards stay accurate as articles get added.
// ─────────────────────────────────────────────────────────────────────────────

import { Icon } from 'astro-icon/components';
import { TOPICS, type Topic } from '~/data/topics';
import { topicHrefFor } from '~/data/topics';

export interface Props {
  /** Optional map of topic slug → actual post count to display alongside the static `countLabel`. */
  postsByTopic?: ReadonlyMap<string, number>;
  /** Show section heading (used when embedded in /blog/; hidden on /blog/topics/ where the page already has one). */
  showHeading?: boolean;
  /** Heading copy override. */
  heading?: string;
  /** Subtitle override. */
  subtitle?: string;
  /** Tailwind grid column class. Defaults to a 3-col responsive grid that
   *  flows the 9 topics into a tidy 3×3 matrix at desktop widths. */
  columnsClass?: string;
}

const {
  postsByTopic,
  showHeading = true,
  heading = 'Browse by Topic',
  subtitle = 'Nine curated tracks — from head-to-head material comparisons to AI-cited reference tables — built around the questions our customers actually ask.',
  columnsClass = 'sm:grid-cols-2 lg:grid-cols-3',
} = Astro.props;

function postCountFor(slug: string): number | undefined {
  return postsByTopic?.get(slug);
}
---

{
  showHeading && (
    <header class="mb-8 md:mb-10 text-center max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold leading-tighter tracking-tighter font-heading">
        {heading}
      </h2>
      {subtitle && (
        <p class="mt-3 text-base md:text-lg text-muted dark:text-slate-400">
          {subtitle}
        </p>
      )}
    </header>
  )
}

<div class:list={['grid gap-5 md:gap-6 mx-auto', columnsClass]}>
  {
    TOPICS.map((topic: Topic) => {
      const live = postCountFor(topic.slug);
      const countDisplay = live !== undefined ? `${live} / ${topic.countLabel}` : topic.countLabel;
      return (
        <a
          href={topicHrefFor(topic)}
          class:list={[
            'group relative flex flex-col p-6 rounded-lg border border-slate-200 dark:border-slate-700',
            'shadow-sm hover:shadow-md transition-shadow duration-200',
            'intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade',
          ]}
        >
          <div class="flex items-start gap-4">
            <div
              class:list={[
                'flex-none flex items-center justify-center',
                'w-11 h-11 rounded-md',
                'border border-slate-200 dark:border-slate-700',
                'text-primary',
              ]}
            >
              <Icon name={topic.icon} class="w-6 h-6" />
            </div>
            <div class="min-w-0">
              <h3 class="text-lg font-bold font-heading text-default dark:text-slate-200 group-hover:text-primary transition-colors">
                {topic.title}
              </h3>
              <span class="mt-0.5 inline-block text-xs font-semibold uppercase tracking-wide text-muted dark:text-slate-400">
                {countDisplay} {topic.targetCount === 1 ? 'entry' : 'posts'}
              </span>
            </div>
          </div>

          <p class="mt-4 text-sm text-muted dark:text-slate-400 leading-relaxed">
            {topic.description}
          </p>

          <span class="mt-5 inline-flex items-center text-sm font-semibold text-primary">
            Browse topic
            <Icon
              name="tabler:arrow-right"
              class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-0.5"
            />
          </span>
        </a>
      );
    })
  }
</div>
