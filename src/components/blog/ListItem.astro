---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class="group flex flex-col h-full rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition duration-200 intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
>
  {
    image &&
      (link ? (
        <a class="relative block aspect-[16/10] overflow-hidden" href={link ?? 'javascript:void(0)'}>
          <Image
            src={image}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            widths={[400, 600, 900]}
            width={900}
            height={563}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            alt={post.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <div class="relative aspect-[16/10] overflow-hidden">
          <Image
            src={image}
            class="absolute inset-0 w-full h-full object-cover"
            widths={[400, 600, 900]}
            width={900}
            height={563}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            alt={post.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
  }
  <div class="flex flex-col flex-grow p-5 sm:p-6">
    <time datetime={String(post.publishDate)} class="text-xs sm:text-sm text-muted dark:text-slate-400 mb-2 sm:mb-3">
      {getFormattedDate(post.publishDate)}
    </time>
    <h2 class="text-base sm:text-lg font-bold leading-snug mb-2 sm:mb-3 font-heading dark:text-slate-300">
      {
        link ? (
          <a
            class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200"
            href={link}
          >
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h2>
    {post.excerpt && <p class="text-sm text-muted dark:text-slate-400 line-clamp-3">{post.excerpt}</p>}
  </div>
</article>
