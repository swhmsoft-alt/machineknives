---
// src/components/blog/SinglePost.astro
// ─────────────────────────────────────────────────────────────────────────────
// Article detail layout for /blog/<category>/<slug>/.
//
// Visual registers (top → bottom):
//   1. Article Hero  — deep-blue radial gradient (same --aw-gradient-hero
//      token used by the homepage Hero). Title, eyebrow pill (category),
//      metadata line and excerpt all live here in white-on-dark. Gives
//      every article a real hero weight instead of the previous flat
//      "personal blog" feel.
//   2. Lede figure    — 4-col-wide floating card that overlaps the hero by
//      14 on md+ via negative top margin, giving a layered "card peels
//      off the gradient" effect. Rounded-2xl, border, shadow-deep.
//   3. Body           — unchanged max-w-3xl prose column. The existing
//      Tailwind Typography styles already read well; the visual lift
//      comes entirely from the hero + lede figure above.
//   4. Tags + share   — unchanged.
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import ArticleTOC from '~/components/blog/ArticleTOC.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<article>
  {/* ─── 1. Article Hero ──────────────────────────────────────────────
   * Deep-blue radial gradient with all hero text in white. Mirrors the
   * homepage Hero via --aw-gradient-hero so every blog post lands on
   * the same brand canvas.
   */}
  <header class="article-hero relative isolate overflow-hidden">
    <div class="article-hero-bg absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-14 md:py-20 lg:py-24 text-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      {
        post.category && (
          <a
            href={getPermalink(post.category.slug, 'category')}
            class="article-eyebrow inline-block mb-5"
          >
            {post.category.title}
          </a>
        )
      }

      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 mb-5 text-sm text-white/75">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="tabler:clock" class="w-4 h-4" aria-hidden="true" />
          <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        </span>
        {
          post.author && (
            <>
              <span aria-hidden="true">·</span>
              <span class="inline-flex items-center gap-1.5">
                <Icon name="tabler:user" class="w-4 h-4" aria-hidden="true" />
                {post.author}
              </span>
            </>
          )
        }
        {
          post.readingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.readingTime} min read</span>
            </>
          )
        }
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tighter font-heading text-white">
        {post.title}
      </h1>

      {
        post.excerpt && (
          <p class="mt-5 text-lg md:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">
            {post.excerpt}
          </p>
        )
      }
    </div>
  </header>

  {/* ─── 2. Lede figure ────────────────────────────────────────────────
   * Renders only if the post has an image. Negative top margin lifts
   * the card over the hero edge on md+, creating a "peel" effect.
   */}
  {
    post.image ? (
      <figure class="mx-auto max-w-4xl px-4 sm:px-6 -mt-8 md:-mt-14 mb-10 md:mb-14 relative z-10 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <Image
          src={post.image}
          class="w-full aspect-[16/9] object-cover rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 shadow-deep"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 800px"
          alt={post?.excerpt || post.title}
          width={1200}
          height={675}
          format="webp"
          loading="eager"
          decoding="async"
        />
      </figure>
    ) : (
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <div class="border-t dark:border-slate-700" />
      </div>
    )
  }
    {/* ─── 3. Body — 2-column on lg+, single column on mobile ───────────────
   * The outer grid gives 220-240px to a sticky TOC sidebar on the left and
   * the remaining width to the article prose. Mobile collapses to single
   * column and exposes the TOC as a collapsible <details> at the top of
   * the article. The actual TOC rendering + scroll-spy live in
   * src/components/blog/ArticleTOC.astro.
   */}
  <div class="lg:max-w-7xl lg:mx-auto lg:grid lg:grid-cols-[220px_minmax(0,1fr)] xl:grid-cols-[240px_minmax(0,1fr)] lg:gap-x-12 xl:gap-x-16 lg:px-6">
    {/* Desktop sticky sidebar */}
    <aside class="hidden lg:block">
      <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto py-2 pr-2">
        <ArticleTOC headings={post.headings ?? []} />
      </div>
    </aside>

    {/* Body column */}
    <div>
      {/* Mobile-only collapsible TOC. Rendered only when there are at
          least 2 H2/H3 headings, matching the ArticleTOC visibility rule. */}
      {(post.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3).length >= 2 && (
        <details class="lg:hidden mb-8 mx-6 sm:mx-auto max-w-3xl group rounded-lg border border-slate-200 dark:border-slate-700 bg-page shadow-sm">
          <summary class="cursor-pointer px-4 py-3 text-sm font-semibold flex items-center justify-between gap-3 marker:hidden [&::-webkit-details-marker]:hidden">
            <span class="inline-flex items-center gap-2">
              <Icon name="tabler:list" class="w-4 h-4 text-primary" aria-hidden="true" />
              On this page
            </span>
            <span class="inline-flex items-center gap-2 text-muted text-xs font-normal">
              {(post.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3).length} sections
              <Icon name="tabler:chevron-down" class="w-4 h-4 transition-transform group-open:rotate-180" aria-hidden="true" />
            </span>
          </summary>
          <div class="border-t border-slate-200 dark:border-slate-700 p-4">
            <ArticleTOC headings={post.headings ?? []} />
          </div>
        </details>
      )}

      {/* Article prose. Tailwind Typography handles all heading / list /
          table styling. `prose-headings:scroll-mt-[80px]` keeps anchor
          jumps below the sticky header. */}
      <div class="mx-auto px-6 sm:px-6 lg:px-0 max-w-3xl prose prose-md lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0">
        <slot />
      </div>

      {/* ─── 4. Tags + share ───────────────────────────────────────────────*/}
      <div class="mx-auto px-6 sm:px-6 lg:px-0 max-w-3xl mt-10 mb-4 flex justify-between flex-col sm:flex-row gap-4 sm:gap-0">
        <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
        <SocialShare
          url={url}
          text={post.title}
          class="mt-2 sm:mt-1 align-middle text-gray-500 dark:text-slate-600"
        />
      </div>
    </div>
  </div>
</article>

<style>
  /* === Article Hero: deep-blue gradient + light text ===================
   * Mirrors the homepage Hero (--aw-gradient-hero) so every blog post
   * lands on the same brand canvas. The eyebrow pill reuses the same
   * accent treatment as Hero's tagline pill.
   */
  .article-hero {
    color: var(--aw-color-text-on-dark);
  }

  .article-hero-bg {
    background: var(--aw-gradient-hero);
  }

  .article-eyebrow {
    padding: 0.45rem 1.1rem;
    border-radius: var(--aw-radius-pill);
    background-color: var(--aw-color-accent);
    color: var(--aw-color-text-on-accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    box-shadow: var(--aw-shadow-cta);
    transition: transform 0.2s ease;
  }
  .article-eyebrow:hover {
    transform: translateY(-1px);
  }
</style>
