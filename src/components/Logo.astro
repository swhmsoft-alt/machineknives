---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-2 self-center ml-2 rtl:ml-0 rtl:mr-2 whitespace-nowrap">
  <svg
    viewBox="0 0 28 8"
    class="h-1.5 w-9 shrink-0 text-default"
    aria-hidden="true"
    role="presentation"
  >
    <rect x="0" y="3" width="22" height="2" fill="currentColor" />
    <polygon points="22,2 28,4 22,6" class="logo-tip" />
  </svg>
  <span class="font-bold tracking-[-0.02em] text-lg md:text-base text-default" set:html={SITE?.name} />
</span>

<style>
  /* The blade tip picks up the new oxide-red token rather than
   * inheriting from the SVG's currentColor (which is graphite).
   * Using the CSS variable keeps dark mode auto-adaptive. */
  .logo-tip {
    fill: var(--aw-color-accent);
  }
</style>
